## presets/docker/images.toml
[binds]
"@Accept" = Accept
"@accept" = Accept
"@accept_2" = Accept
"@break" = Redraw
"@config_exec" = Execute($DOCKERcmd image inspect {id} | PG_LANG=json $PAGER)
"@copy" = CopyAsync(printf '%s
' {+1})
"@copy_active" = CopyAsync(printf '%s
' {+!})
"@copy_all" = CopyAsync(printf {})
"@copy_tag" = ExecuteOrConfirm(
        printf "Copy {repo}:{tag} to (new name): "
        read -r newname
        if [[ -n "$newname" ]]; then
            $DOCKERcmd image tag {id} "$newname"
        fi
    )
"@cycle" = ReloadNext
"@help" = Help
"@look" = Execute(eval $MM_PREVIEW_COMMAND | $PAGER)
"@new_tag" = ExecuteOrConfirm(
        printf "New tag for {repo} -> {repo}:"
        read -r newtag
        if [[ -n "$newtag" ]]; then
            $DOCKERcmd image tag {id} "{repo}:$newtag"
        fi
    )
"@next" = ReloadNext
"@open" = Execute($EDITOR {1})
"@open_2" = Become($EDITOR {1})
"@prev" = ReloadPrev
"@print" = Print({-})
"@print_2" = Print({-!})
"@pull" = ExecuteOrConfirm($DOCKERcmd image pull {repo}:{tag}) Status(Pulling...)
"@push" = ExecuteOrConfirm($DOCKERcmd image push {repo}:{tag}) Status(Pushing...)
"@reload" = Reload
"@rename_tag" = ExecuteOrConfirm(
        printf "Rename {repo}:{tag} to (new name): "
        read -r newname
        if [[ -n "$newname" ]]; then
            $DOCKERcmd image tag {id} "$newname" &&
            $DOCKERcmd image rmi {repo}:{tag}
        fi
    )
"@retag" = ExecuteOrConfirm(
        printf "Retag {repo}:{tag} -> {repo}:"
        read -r newtag
        if [[ -n "$newtag" ]]; then
            $DOCKERcmd image tag {id} "{repo}:$newtag" &&
            $DOCKERcmd image rmi {repo}:{tag}
        fi
    )
"@rmi" = ExecuteOrConfirm($DOCKERcmd image rmi {repo}:{tag}) Status(Removing...), Reload
"@rmi_id" = ExecuteOrConfirm($DOCKERcmd image rmi {id}) Status(Removing by ID...), Reload
"@save_tar" = ExecuteOrConfirm(
        printf "Save as (filename): "
        read -r filename
        if [[ -n "$filename" ]]; then
            $DOCKERcmd image save {id} -o "$filename"
        fi
    )
"@stats" = Preview($DOCKERcmd image history {id})
"@unwind" = Unwind
"Alt-/" = PreviewJump
"Alt-0" = Pos(-1)
"Alt-1" = Pos(0)
"Alt-=" = ExpandPreview(2)
"Alt-Down" = VScroll(-1)
"Alt-Enter" = @Accept
"Alt-Hyphen" = ShrinkPreview(2)
"Alt-Left" = HScroll(-1)
"Alt-Right" = HScroll(1)
"Alt-Shift-=" = ExpandPreview(10)
"Alt-Shift-p" = @print_2
"Alt-Up" = VScroll(1)
"Alt-a" = QueryPos(0)
"Alt-d" = @rmi_id
"Alt-h" = Help
"Alt-n" = @rename_tag
"Alt-o" = @open_2
"Alt-p" = @print
"Alt-r" = @push
"Alt-s" = @save_tar
"Alt-t" = @retag
"Alt-y" = @copy_active
"Backspace" = DeleteChar
"Ctrl-." = NextColumn
"Ctrl-/" = CyclePreview
"Ctrl-Enter" = @accept_2
"Ctrl-Left" = BackwardWord
"Ctrl-Right" = ForwardWord
"Ctrl-Shift-." = PrevColumn
"Ctrl-Shift-/" = CyclePreview
"Ctrl-Shift-BackTab" = @prev
"Ctrl-Shift-Down" = VScroll(-1)
"Ctrl-Shift-Left" = HScroll(-1)
"Ctrl-Shift-Right" = HScroll(1)
"Ctrl-Shift-Tab" = @prev
"Ctrl-Shift-Up" = VScroll(1)
"Ctrl-Shift-n" = @next
"Ctrl-Shift-p" = @prev
"Ctrl-Shift-r" = @reload_2
"Ctrl-Shift-y" = @copy_all
"Ctrl-Tab" = @next
"Ctrl-]" = ExpandPreview(2)
"Ctrl-a" = CycleAll
"Ctrl-c" = Quit
"Ctrl-d" = @rmi
"Ctrl-g" = Pos(-1)
"Ctrl-h" = DeleteWord
"Ctrl-j" = Down
"Ctrl-k" = Up
"Ctrl-l" = @look
"Ctrl-n" = @copy_tag
"Ctrl-o" = SwitchPreview(1)
"Ctrl-p" = SwitchPreview
"Ctrl-r" = @pull
"Ctrl-s" = @show
"Ctrl-t" = @new_tag
"Ctrl-u" = Cancel
"Ctrl-y" = @copy
"Delete" = @rm
