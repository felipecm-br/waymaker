## presets/docker/containers.toml
[binds]
"@Accept" = Accept
"@accept" = Accept
"@accept_2" = Accept
"@break" = Redraw
"@copy" = CopyAsync(printf '%s
' {+1})
"@copy_active" = CopyAsync(printf '%s
' {+!})
"@copy_all" = CopyAsync(printf {})
"@cycle" = ReloadNext
"@exec" = Become("$DOCKERcmd" exec -it {id} sh -c "if command -v zsh > /dev/null 2>&1; then exec zsh; elif command -v bash > /dev/null 2>&1; then exec bash; else exec sh; fi")
"@follow_logs" = Preview("$DOCKERcmd" logs -f -t {id})
"@help" = Help
"@kill" = Execute("$DOCKERcmd" kill {id}) Status(Killing...)
"@look" = Execute(eval $MM_PREVIEW_COMMAND | $PAGER)
"@mount" = BecomeOrConfirm(
    container_id={id}
    mounted_dir=$(podman unshare -- podman mount "$container_id") || { echo "Mount failed" && read; exit 1; }
    echo "Mounted at: $mounted_dir"
    echo "$mounted_dir" | tee >(${=CLIPcmd})
    cd "$mounted_dir"
    echo "Entering podman unshare shell. Type 'exit' to return. Use 'podman unmount $container_id' later to cleanup."
    podman unshare
    exec $SHELL
)
"@next" = ReloadNext
"@open" = Execute($EDITOR {1})
"@open_2" = Become($EDITOR {1})
"@prev" = BecomeSilent(wm -o docker/compose)
"@print" = Print({-})
"@print_2" = Print({-!})
"@reload" = Reload
"@restart" = Execute("$DOCKERcmd" restart {id}) Status(Restarting...)
"@rm" = Execute("$DOCKERcmd" rm -f {id}) Status(Removing...)
"@show_2" = #diff, Preview("$DOCKERcmd" diff {id})
"@show_stats" = Preview("$DOCKERcmd" stats {id})
"@toggle_pause" = Execute(
    if [[ {state} == paused ]]; then
        "$DOCKERcmd" unpause {id}
    else
        "$DOCKERcmd" pause {id}
    fi
)
"@toggle_start" = Execute(
    if [[ {state} == exited || {state} == created ]]; then
        "$DOCKERcmd" start {id}
    else
        "$DOCKERcmd" stop {id}
    fi
)
"@unwind" = Unwind
"Alt-/" = PreviewJump
"Alt-0" = Pos(-1)
"Alt-1" = Pos(0)
"Alt-=" = ExpandPreview(2)
"Alt-Down" = VScroll(-1)
"Alt-Enter" = @Accept
"Alt-Hyphen" = ShrinkPreview(2)
"Alt-Left" = HScroll(-1)
"Alt-Right" = HScroll(1)
"Alt-Shift-=" = ExpandPreview(10)
"Alt-Shift-p" = @print_2
"Alt-Up" = VScroll(1)
"Alt-a" = QueryPos(0)
"Alt-d" = @diff
"Alt-h" = Help
"Alt-o" = @open_2
"Alt-p" = @print
"Alt-r" = @rm, Reload
"Alt-y" = @copy_active
"Backspace" = DeleteChar
"Ctrl-." = NextColumn
"Ctrl-/" = CyclePreview
"Ctrl-Enter" = @accept_2
"Ctrl-Left" = BackwardWord
"Ctrl-Right" = ForwardWord
"Ctrl-Shift-." = PrevColumn
"Ctrl-Shift-/" = CyclePreview
"Ctrl-Shift-BackTab" = @prev
"Ctrl-Shift-Down" = VScroll(-1)
"Ctrl-Shift-Left" = HScroll(-1)
"Ctrl-Shift-Right" = HScroll(1)
"Ctrl-Shift-Tab" = @prev
"Ctrl-Shift-Up" = VScroll(1)
"Ctrl-Shift-n" = @next
