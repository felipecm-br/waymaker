## presets/terminal/mutagen.toml
[binds]
"@Accept" = Accept
"@accept" = Accept
"@accept_2" = Accept
"@break" = Redraw
"@copy" = CopyAsync(printf '%s
' {+1})
"@copy_active" = CopyAsync(printf '%s
' {+!})
"@copy_all" = #copy conflicting file paths, CopyAsync(mutagen sync list {+name} --template '{{range .}}{{range .SessionState.Conflicts}}{{if .Root}}{{.Root}}{{"\n"}}{{end}}{{range .AlphaChanges}}{{if .Path}}{{.Path}}{{"\n"}}{{end}}{{end}}{{range .BetaChanges}}{{if .Path}}{{.Path}}{{"\n"}}{{end}}{{end}}{{end}}{{end}}')
"@cycle" = ReloadNext
"@flush" = #flush sync, ExecuteOrConfirm(mutagen sync flush {+name}), Reload
"@help" = Help
"@look" = Execute(eval $MM_PREVIEW_COMMAND | $PAGER)
"@next" = ReloadNext
"@open" = Execute($EDITOR {1})
"@open_2" = Become($EDITOR {1})
"@pause" = #pause sync, ExecuteOrConfirm(mutagen sync pause {+name}), Reload
"@prev" = ReloadPrev
"@print" = Print({-})
"@print_2" = Print({-!})
"@reload" = Reload
"@reset" = #reset history, ExecuteOrConfirm(
printf "Reset sync history for %s? [y/N] " {name}
read -r ans
case "$ans" in
    [Yy]*) mutagen sync reset {+name} ;;
    *) exit 0 ;;
esac
), Reload
"@resume" = #resume sync, ExecuteOrConfirm(mutagen sync resume {+name}), Reload
"@rm" = #terminate session, ExecuteOrConfirm(
printf "Terminate sync session %s? [y/N] " {name}
read -r ans
case "$ans" in
    [Yy]*) mutagen sync terminate {+name} ;;
    *) exit 0 ;;
esac
), Reload
"@show" = #show detailed info, RunPreview(mutagen sync list -l {name})
"@unwind" = Unwind
"Alt-/" = PreviewJump
"Alt-0" = Pos(-1)
"Alt-1" = Pos(0)
"Alt-=" = ExpandPreview(2)
"Alt-Down" = VScroll(-1)
"Alt-Enter" = @Accept
