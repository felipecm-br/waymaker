## presets/switcher/macos.main.toml
[binds]
"@Accept" = Accept
"@accept" = Become(launchctl asuser $(id -u) "$(dirname -- "$MM_OVERRIDE")"/switch --pid {pid} --title {title} --bounds {bounds})
"@accept_2" = Accept
"@break" = Redraw
"@copy" = CopyAsync(
pid={pid}; app={app}; eval "$RESOLVE_APP"
echo "$app_path"
)
"@copy_active" = CopyAsync(printf '%s
' {+!})
"@copy_all" = CopyAsync(printf {})
"@cycle" = ReloadNext
"@help" = Help
