## presets/git/restore.toml
[binds]
"@Accept" = #apply stash/hard reset, BecomeOrConfirm(
set -e
case $MM_INDEX in
  1)
    echo "### Pop Stash ###\n"

    echo "Working directory:"
    printf "%${COLUMNS}s\n" | tr ' ' '-'
    git --no-pager diff --stat

    echo "Stash changes:"
    printf "%${COLUMNS}s\n" | tr ' ' '-'
    git --no-pager stash show {1}
    echo
  ;;
  *)
  echo "### Hard Reset ###\n"

  echo "--- File changes ---"
  git --no-pager diff --stat HEAD {1}
  echo

  echo "--- Commits ADDED ---"
  git --no-pager log --oneline HEAD..{1}
  echo

  echo "--- Commits REMOVED ---"
  git --no-pager log --oneline {1}..HEAD
  echo
  ;;
esac

printf 'Proceed? [y/N] '
read -r c
case $c in
  [y]) ;;
  *) exit 100;;
esac

case $MM_INDEX in
1) git stash apply {1} ;;
*) git reset --hard {1} ;;
esac
)
"@accept" = @checkout, Reload
"@accept_2" = Accept
"@break" = Redraw
"@checkout" = BecomeOrConfirm(
set -e

case $MM_INDEX in
  1)
    echo "### Apply Stash ###\n"

    echo "Working directory:"
    printf "%${COLUMNS}s\n" | tr ' ' '-'
    git --no-pager diff --stat

    echo "Stash changes:"
    printf "%${COLUMNS}s\n" | tr ' ' '-'
    git --no-pager stash show {1}
    echo
  ;;
  *)
  echo "### Checkout ###\n"

  git --no-pager diff --stat {1} -- {$1}
  ;;
esac

[ -n "$(git status --porcelain -- {$1})" ] &&
printf 'Proceed (or stash (all) changes)? [y/N/s/a] ' ||
printf 'Proceed? [y/N] '

read -r c
case $c in
  [s])
  git stash push -- {$1} ;;
  [au])
  git stash push -u -- {$1} ;;
  [y]) ;;
  *) exit 100 ;;
esac

case $MM_INDEX in
  # return on success
  1) git stash pop {1} && exit 100 ;;
  # leave on success
  *) git checkout {1} -- {$1} ;;
esac
)
"@clean" = ExecuteOrConfirm(
set -e

case $MM_INDEX in
0)
  set -- {+1};
  if (($# > 1)) && command -v git-squash >/dev/null 2>&1; then
    git-squash "$@" # git-squash will prompt
    exit 1 # keep output visible
  else
    printf "Stash all changes to HEAD? [Y/n/or type custom message]: "
    read -r ans
    case "$ans" in
      [yY]*|"")
        git stash
        ;;
      [nN]*)
        ;;
      *)
        git stash push -u -m "$ans"
        ;;
      esac
  fi
  ;;

1)
  git stash drop {1}
  ;;

2)
  printf "WARNING: Destructive action. Permanent data deletion.\n"
  printf "Proceed with full cleanup GC (expire reflogs)? [y/N] "
  read -r ans
  case "$ans" in
    [yY]*)
      echo "Purging history and running GC..."
      git -c gc.reflogExpire=0 -c gc.reflogExpireUnreachable=0 \
      -c gc.rerere.rresolved=0 -c gc.rerere.unresolved=0 \
      -c gc.pruneExpire=now gc
      false
      ;;
  esac
  ;;

3)
  printf "Run aggressive GC (recompress + remove old unreachable data)? [y/N] "
  read -r ans
  case "$ans" in
    [yY]*)
      git gc --prune=now --aggressive
      false
      ;;
  esac
  ;;

esac
)
"@compare" = RunPreview(
set -- $(git rev-list --left-right --count HEAD..{1})
behind=$1
ahead=$2
commits=$(git rev-list --count {1})
echo "behind: $behind ahead: $ahead commits: $commits"
printf "%${COLUMNS}s\n" | tr ' ' '-'
git log --color=always --left-right --oneline ...{1}
)
"@copy" = CopyAsync(printf '%s
' {+1})
"@copy_active" = CopyAsync(printf '%s
' {+!})
"@copy_all" = CopyAsync(printf {})
"@cycle" = ReloadNext
"@diffstat" = RunPreview(
case $MM_INDEX in
  1)
  git stash show -u {1}
  ;;
  *)
  git --no-pager diff --color=always --stat {1}
  ;;
esac
exit 1
)
"@edit_msg" = ExecuteOrConfirm(
set -e

case $MM_INDEX in
0)
  echo "Commit message (\ -> continue): "
  msg=""
  while IFS= read -r line; do
    if [[ "$line" == *'\' ]]; then
      msg+="${line%?}"$'\n'
      printf "> "
    else
      msg+="$line"
      break
    fi
  done

  if [ -z "$msg" ]; then
    echo "Commit message cannot be empty."
    exit 1
  fi

  # Find the parent commit, or default to root if it's the first commit ever
  parent="$(git rev-parse {1}^ 2>/dev/null || echo '--root')"

  TARGET_SHA="$(git rev-parse {1} 2>/dev/null)"
  HEAD_SHA="$(git rev-parse HEAD 2>/dev/null)"

  if [ "$TARGET_SHA" = "$HEAD_SHA" ]; then
      # No rebase needed, just amend directly
      git commit --allow-empty --amend -m "$msg"
  else
      # Find the parent commit, or default to root
      parent="$(git rev-parse {1}^ 2>/dev/null || echo '--root')"

      if sed --version 2>/dev/null | grep -q GNU; then
          SED_CMD="sed -i"
      else
          SED_CMD="sed -i ''"
      fi

      # Start the rebase
      GIT_SEQUENCE_EDITOR="$SED_CMD '1s/^pick /edit /'" git rebase -i "$parent"

      # Amend the message
      git commit --allow-empty --amend -m "$msg"

      # Finish replaying subsequent commits
      git rebase --continue
  fi
  ;;
1)
  echo "Commit message (\ -> continue): "
  msg=""
  while IFS= read -r line; do
    if [[ "$line" == *'\' ]]; then
      msg+="${line%?}"$'\n'
      printf "> "
    else
      msg+="$line"
      break
    fi
  done

  if [ -z "$msg" ]; then
    echo "Commit message cannot be empty."
    exit 1
  fi

  STASH_SHA="$(git rev-parse {1} 2>/dev/null)"
  git stash drop {1}
  git stash store -m "$msg" "$STASH_SHA"
*)
  echo "Unavailable"
  exit 1
  ;;
esac
)
"@help" = RunPreview(
  echo 'Restoring:';
  for f in {$0}; do echo "$f"; done
  printf "%${COLUMNS}s\n" | tr ' ' '-'
)
"@look" = Execute(eval $MM_PREVIEW_COMMAND | $PAGER)
"@next" = BecomeSilent(wm -o git/switch)
"@open" = ExecuteOrConfirm($EDITOR {$1})
"@open_2" = 
"@prev" = BecomeSilent(wm -o git/status -F)
"@print" = Print({-})
"@print_2" = Print({-!})
"@rebase" = Execute(git rebase -i {1}'^')
"@reload" = ReloadNext
"@reload_2" = ReloadPrev
"@rm" = #squash/stash/drop/clean, @clean, Reload
"@soft_reset" = BecomeOrConfirm(
set -e
case $MM_INDEX in
1)
  TARGET={1}
  FILES="$(git stash show --name-only "$TARGET" 2>/dev/null || true)"
  STASHED="$(git rev-parse refs/stash 2>/dev/null || true)"

  if [ -n "$FILES" ] &&
    printf '%s\n' "$FILES" |
    git status --porcelain --pathspec-from-file=- |
    grep -q .
  then
    printf 'Affected files are dirty. Proceed? [y/N/s(tash)] '
  else
    printf 'Proceed? [y/N] '
  fi

  read -r c
  case "$c" in
    [sS])
      if [ -n "$FILES" ]; then
        printf '%s\n' "$FILES" |
        git stash push -m "temp backup before stash pop" --pathspec-from-file=-
      else
        git stash push -m "temp backup stash pop"
      fi
      ;;
    [yY])
      ;;
    *)
      exit 100
      ;;
  esac

  # Shift target index if stash was created.
  NEW_STASH="$(git rev-parse refs/stash 2>/dev/null || true)"
  if [ "$STASHED" != "$NEW_STASH" ] && [ -n "$NEW_STASH" ]; then
      STASHED=true
      N=$(echo "$TARGET" | grep -oE '[0-9]+' || echo 0)
      TARGET="stash@{$((N+1))}"
  else
      STASHED=false
  fi

  printf "Applying %s...\n" "$TARGET"
  git stash apply "$TARGET"

  printf "\nDiff after applying:\n"
  git -c color.ui=always status --short
  git diff --color=always || true

  printf '\nKeep changes? [Y/n/(p)reserve] '
  read -r ans2
  case "${ans2%% *}" in
    [yY]|'')
      git stash drop "$TARGET"
      ;;
    [pP])
      # Preserve: do nothing to the target stash
      ;;
    *)
      echo "Reverting stash..."
      git stash show -p "$TARGET" | git apply --reverse # kills script on fail
      ;;
  esac

  if $STASHED; then
      echo "Restoring previous working directory state..."
      git stash pop stash@{0}
  fi
  ;;
*)
  git --no-pager diff --name-status {1}..HEAD # --color=always inapplicable
  printf "Soft reset to %s? [y/N] " {1}
  read -r ans
  case "$ans" in
    [yY]*) git reset --soft {1} ;;
    *) exit 100 ;;
  esac
  ;;
esac
)
"@tag" = BecomeOrConfirm(
set -e

case $MM_INDEX in
0|3)
  printf "Enter tag name for %s: " {1}
  read -r tag_name

  [ -n "$tag_name" ]
  delete="";
  remote=$(git rev-parse --abbrev-ref --symbolic-full-name @{u})

  if git rev-parse -q --verify "refs/tags/$tag_name" >/dev/null; then
    printf "Tag '%s' already exists. Remove it? [y/N] " "$tag_name"
    read -r ans

    case "$ans" in
      [yY]*)
        git tag -d "$tag_name"
        echo "Deleted local tag $tag_name"
        delete=--delete
        ;;
      *)
        exit 100
        ;;
    esac
  else
    git tag "$tag_name" {1}
    echo "Tagged {1} as $tag_name"
  fi

  printf "push tag '%s' to $remote? [y/(f)orce/N] " "$tag_name"
  read -r ans

  case "$ans" in
    [fF]*)
      git push --force $delete $remote "$tag_name"
      ;;
    [yY]*)
      git push $delete $remote "$tag_name"
      ;;
    *)
      exit 100
      ;;
  esac
  ;;
1)
  printf "Branch name for %s: " {1}
  read -r ans
  if [ -n "$ans" ]; then
    git stash branch "$ans" {1}
  fi
  ;;
2)
  printf "Branch name for reflog entry %s: " {1}
  read -r ans
  if [ -n "$ans" ]; then
    git branch "$ans" {1}
  fi
  ;;
esac
)
"@unwind" = Unwind
"Alt-/" = PreviewJump
"Alt-0" = Pos(-1)
"Alt-1" = Pos(0)
"Alt-=" = ExpandPreview(2)
"Alt-Down" = VScroll(-1)
"Alt-Enter" = @Accept
"Alt-Hyphen" = ShrinkPreview(2)
"Alt-Left" = HScroll(-1)
"Alt-Right" = HScroll(1)
"Alt-Shift-=" = ExpandPreview(10)
"Alt-Shift-p" = @print_2
"Alt-Up" = VScroll(1)
"Alt-a" = QueryPos(0)
"Alt-c" = @diffstat
"Alt-h" = Help
"Alt-m" = @edit_msg, Reload
"Alt-o" = @open_2
"Alt-p" = @print
"Alt-r" = @soft_reset
"Alt-y" = @copy_active
"Backspace" = DeleteChar
"Ctrl-." = NextColumn
"Ctrl-/" = CyclePreview
"Ctrl-Enter" = @accept_2
"Ctrl-Left" = BackwardWord
"Ctrl-Right" = ForwardWord
"Ctrl-Shift-." = PrevColumn
"Ctrl-Shift-/" = CyclePreview
"Ctrl-Shift-BackTab" = @prev
"Ctrl-Shift-Down" = VScroll(-1)
"Ctrl-Shift-Left" = HScroll(-1)
"Ctrl-Shift-Right" = HScroll(1)
"Ctrl-Shift-Tab" = @prev
"Ctrl-Shift-Up" = VScroll(1)
"Ctrl-Shift-n" = @next
"Ctrl-Shift-p" = @prev
"Ctrl-Shift-r" = @reload_2
"Ctrl-Shift-y" = @copy_all
"Ctrl-Tab" = @next
"Ctrl-]" = ExpandPreview(2)
"Ctrl-a" = CycleAll
"Ctrl-c" = @compare
"Ctrl-d" = @rm
"Ctrl-e" = @rebase, Reload
"Ctrl-g" = Pos(-1)
"Ctrl-h" = DeleteWord
"Ctrl-j" = Down
"Ctrl-k" = Up
"Ctrl-l" = @look
"Ctrl-o" = @open
"Ctrl-p" = SwitchPreview
"Ctrl-r" = @reload
"Ctrl-s" = @show
"Ctrl-t" = @tag, Reload
"Ctrl-u" = Cancel
"Ctrl-y" = @copy
"Delete" = @rm
"Down" = Down
"Enter" = @accept
"Esc" = @unwind
"F1" = @help
"F10" = @menu
"F11" = @look
"F12" = @save
"F2" = @rename
"F3" = @search
"F4" = @rm
"F5" = @reload
"F6" = @cycle
"F7" = @build
"F8" = @step
"F9" = @break
"Left" = BackwardChar
"PageDown" = HalfPageDown
"PageUp" = HalfPageUp
"Reloaded" = Transform(
    HEADERS=(
      '[history]'
      '[stash]'
      '[all_refs]'
      '[reachable]'
    )
    setopt KSH_ARRAYS 2>/dev/null
    echo "SetHeader(${HEADERS[$MM_INDEX]})"
)
"Right" = ForwardChar
"Shift-BackTab" = ToggleUp
"Shift-Down" = PreviewHalfPageDown
"Shift-Up" = PreviewHalfPageUp
"Tab" = Toggle
"Up" = Up
"shift+scrolldown" = PreviewDown
"shift+scrollup" = PreviewUp
[ui.nav.binds]
" " = Toggle
"," = SortMenu
"." = NextColumn
"/" = FocusFilter
">" = PrevColumn
"G" = PreviewDown(0)
"J" = PreviewDown
"K" = PreviewUp
"\\" = ToggleParentPeek
"esc" = Quit
"gb" = Pos(-1)
"gg" = PreviewUp(0)
"gt" = Pos(0)
