## presets/cargo-rx.toml
[binds]
"@Accept" = Accept
"@accept" = Transform(
  features={4}
  [[ -n "$features" ]] && features="-F $features"

  case {1} in
    target)
      echo "Become({path} {$0})"
      ;;
    ex)
      echo "Become(cargo run --example {name} $features {$0})"
      ;;
    bin|*)
      echo "Become(cargo run --bin {name} $features {$0})"
      ;;
  esac
)
"@accept_2" = Accept
"@break" = Redraw
"@copy" = CopyAsync(printf '%s
' {+1})
"@copy_active" = CopyAsync(printf '%s
' {+!})
"@copy_all" = CopyAsync(printf {})
"@cycle" = ReloadNext
"@help" = Help
"@look" = Execute(eval $MM_PREVIEW_COMMAND | $PAGER)
"@next" = ReloadNext
"@open" = Execute($EDITOR {1})
"@open_2" = Become($EDITOR {1})
"@prev" = ReloadPrev
"@print" = Print({-})
"@print_2" = Print({-!})
"@reload" = Reload
"@summary" = Execute(
  $PAGER "$(dirname -- "$(dirname -- {path})")/Cargo.toml"
)
"@unwind" = Unwind
"Alt-/" = PreviewJump
"Alt-0" = Pos(-1)
"Alt-1" = Pos(0)
"Alt-=" = ExpandPreview(2)
"Alt-Down" = VScroll(-1)
"Alt-Enter" = @Accept
"Alt-Hyphen" = ShrinkPreview(2)
"Alt-Left" = HScroll(-1)
"Alt-Right" = HScroll(1)
"Alt-Shift-=" = ExpandPreview(10)
"Alt-Shift-p" = @print_2
"Alt-Up" = VScroll(1)
"Alt-a" = QueryPos(0)
"Alt-h" = Help
"Alt-o" = @open_2
"Alt-p" = @print
"Alt-y" = @copy_active
"Backspace" = DeleteChar
"Ctrl-." = NextColumn
