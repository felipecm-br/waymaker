## presets/docker/volumes.toml
[binds]
"@Accept" = Accept
"@accept" = Accept
"@accept_2" = Accept
"@break" = Redraw
"@config_exec" = Execute($DOCKERcmd volume inspect {name} | PG_LANG=json $PAGER)
"@copy" = CopyAsync(printf '%s
' {+1})
"@copy_active" = CopyAsync(printf '%s
' {+!})
"@copy_all" = CopyAsync(printf {})
"@create" = Execute(printf 'Enter volume name: ' && read vol_name && [[ -n "$vol_name" ]] && $DOCKERcmd volume create "$vol_name"), Reload
"@cycle" = ReloadNext
"@help" = Help
"@look" = Execute(eval $MM_PREVIEW_COMMAND | $PAGER)
