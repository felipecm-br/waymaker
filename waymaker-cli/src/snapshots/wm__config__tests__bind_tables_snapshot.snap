## presets/git/browse.toml
[binds]
"@Accept" = Accept
"@accept" = Accept
"@accept_2" = Accept
"@break" = Redraw
"@copy" = CopyAsync(printf '%s
' {+1})
"@copy_active" = CopyAsync(printf '%s
' {+!})
"@copy_all" = CopyAsync(printf {})
"@cycle" = ReloadNext
"@force_add" = ExecuteOrConfirm(
set -- {+1}
for p; do
  [[ "$p" == /* ]] || p="$GIT_PREFIX$p";
  git add -f "$p"
  echo "!$p" >> ".gitignore"
done;
)
