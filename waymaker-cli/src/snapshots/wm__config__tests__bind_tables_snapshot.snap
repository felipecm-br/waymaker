"esc" = Quit
"f" = @dirs
"gb" = Pos(-1)
"gg" = PreviewUp(0)
"gt" = Pos(0)
"h" = ChDir(..), Cancel, Reload
"j" = Down
"k" = Up
"l" = ChDir({=}), Cancel, Reload, Pos(0)
"left" = PreviewHScroll(-6)
"m" = @bookmark
"n" = NextDiagram
"o" = ExecuteSilent("$(dirname -- "$MM_OVERRIDE")"/tmux/open.sh {} "$MM_ORIGIN_CWD")
"q" = Quit
"right" = PreviewHScroll(6)
"s" = ToggleDiagram
"shift-backtab" = @reloadprev
"shift-j" = PreviewDown(5)
"shift-k" = PreviewUp(5)
"shift-tab" = @reloadprev
