## presets/docker/compose.toml
[binds]
"0,1^^@Accept" = #lazydocker, Become(lazydocker -f {id})
"0,1^^@accept" = Become(wm -o docker/containers -- {id} {source})
"@Accept" = Accept
"@accept" = Accept
"@accept_2" = Accept
"@break" = Redraw
"@copy" = CopyAsync(printf '%s
' {+1})
"@copy_active" = CopyAsync(printf '%s
' {+!})
"@copy_all" = CopyAsync(printf {})
"@cycle" = ReloadNext
"@edit_env" = Execute(
    if [[ {source} != "pod" ]]; then
        if [[ {id} == */* ]]; then
            $EDITOR "$(dirname {id})/.env"
        else
            $EDITOR "$DOCKERdir/{name}/.env"
        fi
    else
        echo "No .env for pod source. Press Enter to continue." && read
    fi
)
"@follow_logs" = Preview("$(dirname -- "$MM_OVERRIDE")"/composer.sh {id} logs {source} -f -t)
"@help" = Help
"@look" = Execute(eval $MM_PREVIEW_COMMAND | $PAGER)
"@ls" = RunPreview(
    if [[ {source} == "file" || {source} == "compose" ]]; then
        if [[ {id} == */* ]]; then cd "$(dirname -- {id})"; else cd "$DOCKERdir/{name}"; fi
        fs :tool liza :u2 ::flatten
    else
        echo "No directory for pod source"
    fi
)
"@next" = ReloadNext
"@open" = Execute($EDITOR {1})
"@open_2" = Become($EDITOR {1})
"@prev" = ReloadPrev
"@print" = Print({-})
"@print_2" = Print({-!})
"@recreate" = Execute(@composer.sh {id} up {source} --force-recreate) Status(Recreating...)
"@recreate_all" = Execute(@composer.sh {id} up {source} --renew-anon-volumes --force-recreate) Status(Recreating all...)
"@reload" = Reload
"@restart" = Execute(@composer.sh {id} restart {source} --no-deps) Status(Restarting...)
"@restart_all" = Execute(@composer.sh {id} restart {source}) Status(Restarting all...)
"@show_2" = @ls
"@show_stats" = Preview("$(dirname -- "$MM_OVERRIDE")"/composer.sh {id} stats {source})
"@toggle_pause" = Execute(
    if [[ {status} == *paused* ]]; then
        "$(dirname -- "$MM_OVERRIDE")"/composer.sh {id} unpause {source}
    else
        "$(dirname -- "$MM_OVERRIDE")"/composer.sh {id} pause {source}
    fi
)
"@toggle_start" = Execute(
    if [[ {status} == *exited* || {status} == *stopped* || {status} == *created* ]]; then
        "$(dirname -- "$MM_OVERRIDE")"/composer.sh {id} start {source}
    else
        "$(dirname -- "$MM_OVERRIDE")"/composer.sh {id} stop {source}
    fi
)
"@toggle_up" = Execute(
    if [[ {status} == *down* || {status} == *exited* ]]; then
        "$(dirname -- "$MM_OVERRIDE")"/composer.sh {id} up {source} -d
    else
        "$(dirname -- "$MM_OVERRIDE")"/composer.sh {id} down {source}
    fi
)
"@toggle_up_full" = Execute(
    if [[ {status} == *down* || {status} == *exited* ]]; then
        "$(dirname -- "$MM_OVERRIDE")"/composer.sh {id} up {source} -w
    else
        "$(dirname -- "$MM_OVERRIDE")"/composer.sh {id} down {source} -v --remove-orphans
    fi
)
"@unwind" = Unwind
"Alt-." = @edit_env
"Alt-/" = PreviewJump
"Alt-0" = Pos(-1)
"Alt-1" = Pos(0)
"Alt-=" = ExpandPreview(2)
"Alt-Down" = VScroll(-1)
"Alt-Enter" = @Accept
"Alt-Hyphen" = ShrinkPreview(2)
"Alt-Left" = HScroll(-1)
"Alt-Right" = HScroll(1)
"Alt-Shift-=" = ExpandPreview(10)
"Alt-Shift-p" = @print_2
"Alt-Up" = VScroll(1)
"Alt-a" = @recreate_all, Reload
"Alt-h" = Help
"Alt-o" = @open_2
"Alt-p" = @print
"Alt-r" = @recreate, Reload
"Alt-u" = @toggle_up_full, Reload
"Alt-y" = @copy_active
"Backspace" = DeleteChar
"Ctrl-." = NextColumn
"Ctrl-/" = CyclePreview
"Ctrl-Enter" = @accept_2
"Ctrl-Left" = BackwardWord
"Ctrl-Right" = ForwardWord
"Ctrl-Shift-." = PrevColumn
"Ctrl-Shift-/" = CyclePreview
"Ctrl-Shift-BackTab" = @prev
"Ctrl-Shift-Down" = VScroll(-1)
"Ctrl-Shift-Left" = HScroll(-1)
"Ctrl-Shift-Right" = HScroll(1)
"Ctrl-Shift-Tab" = @prev
"Ctrl-Shift-Up" = VScroll(1)
"Ctrl-Shift-n" = @next
"Ctrl-Shift-p" = @prev
"Ctrl-Shift-r" = @reload_2
"Ctrl-Shift-y" = @copy_all
"Ctrl-Tab" = @next
"Ctrl-]" = ExpandPreview(2)
"Ctrl-a" = @restart_all, Reload
"Ctrl-c" = Quit
"Ctrl-d" = @rm
"Ctrl-g" = Pos(-1)
"Ctrl-h" = DeleteWord
"Ctrl-j" = Down
"Ctrl-k" = Up
"Ctrl-l" = @look
"Ctrl-o" = @open
"Ctrl-p" = SwitchPreview
"Ctrl-r" = @reload
"Ctrl-s" = @show
"Ctrl-u" = @toggle_up, Reload
"Ctrl-y" = @copy
"Delete" = @rm
