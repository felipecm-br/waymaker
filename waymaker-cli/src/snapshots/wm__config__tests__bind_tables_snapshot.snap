## presets/macos/services.toml
[binds]
"@Accept" = Accept
"@accept" = Become(printf '%s
' {pid})
"@accept_2" = Accept
"@break" = Redraw
"@copy" = CopyAsync(
    label={label}; eval "$RESOLVE_TARGET"
    echo "$plist"
)
"@copy_active" = CopyAsync(printf '%s
' {+!})
"@copy_all" = CopyAsync(
    label={label}; eval "$RESOLVE_TARGET"
    echo "$target"
)
"@cycle" = ReloadNext
"@help" = Help
"@kill" = ExecuteOrConfirm(
    failed=1
    for label in {+label}; do
        eval "$RESOLVE_TARGET"
        echo "Booting out $target..."
        launchctl bootout "$target" || failed=1
    done
    exit $failed
)
"@load" = ExecuteOrConfirm(
    failed=1
    for label in {+label}; do
        eval "$RESOLVE_TARGET"
        if [[ -n "$plist" ]]; then
            echo "Bootstrapping $target..."
            launchctl bootstrap "$domain" "$plist" || failed=1
        else
            echo "No plist found for $target, trying kickstart..."
            launchctl kickstart "$target" || failed=1
        fi
    done
    exit $failed
)
"@look" = Execute(eval $MM_PREVIEW_COMMAND | $PAGER)
"@next" = ReloadNext
"@open" = ExecuteOrConfirm(
    label={label}; eval "$RESOLVE_TARGET"
    if [[ -f "$plist" ]]; then
        $EDITOR "$plist"
    else
        echo "plist not found for $target" >&2
        exit 1
    fi
)
"@open_2" = Become($EDITOR {1})
"@pause" = ExecuteOrConfirm(
    failed=1
    for label in {+label}; do
        eval "$RESOLVE_TARGET"
        echo "Stopping $target..."
        launchctl stop "$target" || failed=1
    done
    exit $failed
)
"@prev" = ReloadPrev
"@print" = Print({-})
"@print_2" = Print({-!})
"@reload" = Reload
"@restart" = ExecuteOrConfirm(
    failed=1
    for label in {+label}; do
        eval "$RESOLVE_TARGET"
        echo "Restarting $target..."
        launchctl kickstart -k "$target" || failed=1
    done
    exit $failed
)
"@unload" = ExecuteOrConfirm(
    failed=1
    for label in {+label}; do
        eval "$RESOLVE_TARGET"
        if [[ -n "$plist" ]]; then
            echo "Booting out $target..."
            launchctl bootout "$domain" "$plist" || failed=1
        else
            echo "Booting out $target..."
            launchctl bootout "$target" || failed=1
        fi
    done
    exit $failed
)
"@unwind" = Unwind
"Alt-/" = PreviewJump
"Alt-0" = Pos(-1)
"Alt-1" = Pos(0)
"Alt-=" = ExpandPreview(2)
"Alt-Down" = VScroll(-1)
"Alt-Enter" = @Accept
"Alt-Hyphen" = ShrinkPreview(2)
"Alt-Left" = HScroll(-1)
"Alt-Right" = HScroll(1)
"Alt-Shift-=" = ExpandPreview(10)
"Alt-Shift-p" = @print_2
"Alt-Up" = VScroll(1)
"Alt-a" = QueryPos(0)
"Alt-h" = Help
"Alt-o" = @open_2
"Alt-p" = @print
"Alt-r" = @restart, Reload
"Alt-y" = @copy_active
"Backspace" = DeleteChar
"Ctrl-." = NextColumn
"Ctrl-/" = CyclePreview
"Ctrl-Enter" = @accept_2
"Ctrl-Left" = BackwardWord
"Ctrl-Right" = ForwardWord
"Ctrl-Shift-." = PrevColumn
"Ctrl-Shift-/" = CyclePreview
"Ctrl-Shift-BackTab" = @prev
"Ctrl-Shift-Down" = VScroll(-1)
"Ctrl-Shift-Left" = HScroll(-1)
"Ctrl-Shift-Right" = HScroll(1)
"Ctrl-Shift-Tab" = @prev
"Ctrl-Shift-Up" = VScroll(1)
"Ctrl-Shift-n" = @next
"Ctrl-Shift-p" = @prev
"Ctrl-Shift-r" = @reload_2
"Ctrl-Shift-y" = @copy_all
"Ctrl-Tab" = @next
"Ctrl-]" = ExpandPreview(2)
"Ctrl-a" = CycleAll
"Ctrl-c" = Quit
"Ctrl-d" = @rm
"Ctrl-g" = #go to binary, ExecuteOrConfirm(
        label={label}; eval "$RESOLVE_TARGET"
        program=$(launchctl print "$target" 2>/dev/null | awk '
            /^[ \t]*(program)[ \t]*=[ \t]*/ {
                sub(/^[ \t]*(program)[ \t]*=[ \t]*/, "");
                gsub(/^"|"$/, "");
                print;
                exit;
            }
        ')

        if [[ -e "$program" ]]; then
            echo "Revealing: $program"
            open "$(dirname -- "$program")"
        else
            echo "Binary path not found for $target"
            exit 1
        fi
    )
"Ctrl-h" = DeleteWord
"Ctrl-j" = Down
"Ctrl-k" = @kill, Reload
"Ctrl-l" = @look
"Ctrl-o" = @open
"Ctrl-p" = @pause, Reload
"Ctrl-r" = @reload
"Ctrl-s" = @show
"Ctrl-t" = @load, Reload
"Ctrl-u" = @unload, Reload
"Ctrl-y" = @copy
"Delete" = @rm
