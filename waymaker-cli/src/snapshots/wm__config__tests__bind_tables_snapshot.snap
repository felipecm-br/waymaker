"shift+scrollup" = PreviewUp
[ui.nav.binds]
" " = Toggle
"*" = @bookmark
"+" = ExpandPreview(2)
"," = SortMenu
"-" = ShrinkPreview(2)
"." = NextColumn
"/" = FocusFilter
"=" = ExpandPreview(2)
">" = PrevColumn
"G" = Pos(-1)
"J" = PreviewDown(5)
"K" = PreviewUp(5)
