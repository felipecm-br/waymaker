## presets/ps.toml
[binds]
"@Accept" = #print active, Become(printf '%s
' {+!})
"@accept" = #print pid, Become(printf '%s
' {+2})
"@accept_2" = Accept
"@break" = Redraw
"@copy" = CopyAsync(printf '%s
' {+2})
"@copy_active" = CopyAsync(printf '%s
' {+!})
"@copy_all" = CopyAsync(printf {})
"@cycle" = ReloadNext
"@help" = Help
"@look" = Execute(eval $MM_PREVIEW_COMMAND | $PAGER)
"@next" = ReloadNext
"@open" = Execute($EDITOR {1})
"@open_2" = Become($EDITOR {1})
"@prev" = ReloadPrev
"@print" = Print({-})
"@print_2" = Print({-!})
"@reload" = Reload
"@reload_2" = 
"@show" = RunPreview(echo {9})
"@unwind" = Unwind
"Alt-/" = PreviewJump
"Alt-0" = Pos(-1)
"Alt-1" = Pos(0)
"Alt-=" = ExpandPreview(2)
"Alt-Down" = VScroll(-1)
"Alt-Enter" = @Accept
"Alt-Hyphen" = ShrinkPreview(2)
"Alt-Left" = HScroll(-1)
"Alt-Right" = HScroll(1)
"Alt-Shift-=" = ExpandPreview(10)
"Alt-Shift-k" = #kill parent -9, ExecuteOrConfirm(
        pids=({+1})
        [ ${#pids[@]} -gt 1 ] && {
            printf "Kill: %s [y/N] " "${pids[*]}"
            read -r
            [[ $REPLY != [yY]* ]] && exit 0
        }

        for p in "${pids[@]}"; do
            kill -9 "$p" 2>/dev/null
            sleep 0.1
        done

        f=()
        for p in "${pids[@]}"; do
            kill -0 "$p" 2>/dev/null && f+=("$p")
        done

        if [ ${#f[@]} -ne 0 ]; then
            echo "Failed: ${f[*]}"
            exit 1
        fi

        exit 0
    ), Reload
"Alt-Shift-p" = @print_2
"Alt-Up" = VScroll(1)
"Alt-a" = QueryPos(0)
"Alt-g" = #kill group -9, ExecuteOrConfirm(
        pids=({+2})
        [ ${#pids[@]} -gt 1 ] && {
            printf "Kill: %s [y/N] " "${pids[*]}"
            read -r
            [[ $REPLY != [yY]* ]] && exit 0
        }

        for p in "${pids[@]}"; do
            pgid=$(ps -o pgid= -p "$p" | tr -d ' ')
            [[ -n $pgid ]] && kill -9 -- -"${pgid}" 2>/dev/null
            sleep 0.1
        done

        f=()
        for p in "${pids[@]}"; do
            kill -0 "$p" 2>/dev/null && f+=("$p")
        done

        if [ ${#f[@]} -ne 0 ]; then
            echo "Failed: ${f[*]}"
            exit 1
        fi

        exit 0
    ), Reload
"Alt-h" = Help
"Alt-k" = #kill -9, ExecuteOrConfirm(
        pids=({+2})
        [ ${#pids[@]} -gt 1 ] && {
            printf "Kill: %s [y/N] " "${pids[*]}"
            read -r
            [[ $REPLY != [yY]* ]] && exit 0
        }

        for p in "${pids[@]}"; do
            kill -9 "$p" 2>/dev/null
            sleep 0.1
        done

        f=()
        for p in "${pids[@]}"; do
            kill -0 "$p" 2>/dev/null && f+=("$p")
        done

        if [ ${#f[@]} -ne 0 ]; then
            echo "Failed: ${f[*]}"
            exit 1
        fi

        exit 0
    ), Reload
"Alt-o" = @open_2
"Alt-p" = @print
"Alt-y" = @copy_active
"Backspace" = DeleteChar
"Ctrl-." = NextColumn
"Ctrl-/" = CyclePreview
"Ctrl-Enter" = @accept_2
"Ctrl-Left" = BackwardWord
"Ctrl-Right" = ForwardWord
"Ctrl-Shift-." = PrevColumn
"Ctrl-Shift-/" = CyclePreview
"Ctrl-Shift-BackTab" = @prev
"Ctrl-Shift-Down" = VScroll(-1)
"Ctrl-Shift-Left" = HScroll(-1)
"Ctrl-Shift-Right" = HScroll(1)
"Ctrl-Shift-Tab" = @prev
"Ctrl-Shift-Up" = VScroll(1)
"Ctrl-Shift-k" = #kill parent, ExecuteOrConfirm(
        pids=({+1})
        [ ${#pids[@]} -gt 1 ] && {
            printf "Kill: %s [y/N] " "${pids[*]}"
            read -r
            [[ $REPLY != [yY]* ]] && exit 0
        }

        for p in "${pids[@]}"; do
            kill "$p" 2>/dev/null
            sleep 0.1
        done

        f=()
        for p in "${pids[@]}"; do
            kill -0 "$p" 2>/dev/null && f+=("$p")
        done

        if [ ${#f[@]} -ne 0 ]; then
            echo "Failed: ${f[*]}"
            exit 1
        fi

        exit 0
    ), Reload
"Ctrl-Shift-n" = @next
"Ctrl-Shift-p" = @prev
"Ctrl-Shift-r" = @reload_2
"Ctrl-Shift-y" = @copy_all
"Ctrl-Tab" = @next
"Ctrl-]" = ExpandPreview(2)
"Ctrl-a" = CycleAll
"Ctrl-c" = Quit
"Ctrl-d" = @rm
"Ctrl-g" = #kill group, ExecuteOrConfirm(
        pids=({+2})
        [ ${#pids[@]} -gt 1 ] && {
            printf "Kill: %s [y/N] " "${pids[*]}"
            read -r
            [[ $REPLY != [yY]* ]] && exit 0
        }

        for p in "${pids[@]}"; do
            pgid=$(ps -o pgid= -p "$p" | tr -d ' ')
            [[ -n $pgid ]] && kill -- -"${pgid}" 2>/dev/null
            sleep 0.1
        done

        f=()
        for p in "${pids[@]}"; do
            kill -0 "$p" 2>/dev/null && f+=("$p")
        done

        if [ ${#f[@]} -ne 0 ]; then
            echo "Failed: ${f[*]}"
            exit 1
        fi

        exit 0
    ), Reload
"Ctrl-h" = DeleteWord
"Ctrl-j" = Down
"Ctrl-k" = #kill, ExecuteOrConfirm(
        pids=({+2})
        [ ${#pids[@]} -gt 1 ] && {
            printf "Kill: %s [y/N] " "${pids[*]}"
            read -r
            [[ $REPLY != [yY]* ]] && exit 0
        }

        for p in "${pids[@]}"; do
            kill "$p" 2>/dev/null
            sleep 0.1
        done

        f=()
        for p in "${pids[@]}"; do
            kill -0 "$p" 2>/dev/null && f+=("$p")
        done

        if [ ${#f[@]} -ne 0 ]; then
            echo "Failed: ${f[*]}"
            exit 1
        fi

        exit 0
    ), Reload
"Ctrl-l" = @look
"Ctrl-o" = @open
"Ctrl-p" = SwitchPreview
"Ctrl-r" = @reload
"Ctrl-s" = @show
"Ctrl-u" = Cancel
"Ctrl-y" = @copy
"Delete" = @rm
