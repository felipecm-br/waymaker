## presets/ssh/keys.toml
[binds]
"@Accept" = #copy path, Copy(realpath {}), Accept
"@accept" = #copy, Copy(cat {}), Accept
"@accept_2" = Accept
"@break" = Redraw
"@copy" = CopyAsync(printf '%s
' {+1})
"@copy_active" = CopyAsync(printf '%s
' {+!})
"@copy_all" = CopyAsync(printf {})
"@cycle" = ReloadNext
"@help" = Help
"@look" = Execute(eval $MM_PREVIEW_COMMAND | $PAGER)
"@next" = BecomeSilent(wm -o ssh/known)
"@open" = Execute($EDITOR {1})
"@open_2" = Execute(priv={}; priv="${priv%%.pub}"; [[ -f $priv ]] && $EDITOR "$priv")
"@prev" = BecomeSilent(wm -o ssh/hosts)
"@print" = Print({-})
"@print_2" = Print({-!})
"@reload" = Reload
"@rm" = ExecuteOrConfirm(
pub_key={1}
priv_key="${pub_key%.pub}"

echo "  - $priv_key"
echo "  - $pub_key"
printf "Are you sure you want to permanently delete these files? (y/N): "
read -r confirm

case "$confirm" in
    [yY]|[yY][eE][sS])
        rm -vf "$priv_key" "$pub_key"
        ;;
    *)
        echo "Deletion cancelled."
        exit 0
        ;;
esac
), Reload
"@unwind" = Unwind
"Alt-/" = PreviewJump
"Alt-0" = Pos(-1)
"Alt-1" = Pos(0)
