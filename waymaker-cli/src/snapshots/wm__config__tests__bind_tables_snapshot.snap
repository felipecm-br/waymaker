"Ctrl-Tab" = @next
"Ctrl-]" = ExpandPreview(2)
"Ctrl-a" = CycleAll
"Ctrl-b" = @bookmarks
"Ctrl-c" = Quit
"Ctrl-d" = @rm
"Ctrl-e" = Execute(nvim {+})
