## presets/patches/git-status.toml
[binds]
"@Accept" = Accept
"@accept" = Accept
"@accept_2" = Accept
"@break" = Redraw
"@copy" = CopyAsync(printf '%s
' {+1})
"@copy_active" = CopyAsync(printf '%s
' {+!})
"@copy_all" = CopyAsync(printf {})
"@cycle" = ReloadNext
"@help" = Help
"@look" = Execute(eval $MM_PREVIEW_COMMAND | $PAGER)
"@next" = ReloadNext
"@open" = Execute(
  file={1}
  [[ "$MM_PREVIEW_INDEX" == "1" ]] && flags="--cached" || flags=""
  line=$(git diff --no-ext-diff $flags --unified=0 -- "$file" | awk '/^@@/ {
    match($0, /@@ -([0-9]+)(,[0-9]+)? \+([0-9]+)(,[0-9]+)? @@/, m)
    if (m[3] != "" && m[3] != "0") {
      print m[3]
    } else {
      print m[1]
    }
    exit
  }')
  if [ -n "$line" ] && [ "$line" -gt 0 ] 2>/dev/null; then
    $EDITOR "+$line" "$file"
  else
    $EDITOR "$file"
  fi
), Reload
"@open_2" = Become(
  file={1}
  [[ "$MM_PREVIEW_INDEX" == "1" ]] && flags="--cached" || flags=""
  line=$(git diff --no-ext-diff $flags --unified=0 -- "$file" | awk '/^@@/ {
    match($0, /@@ -([0-9]+)(,[0-9]+)? \+([0-9]+)(,[0-9]+)? @@/, m)
    if (m[3] != "" && m[3] != "0") {
      print m[3]
    } else {
      print m[1]
    }
    exit
  }')
  if [ -n "$line" ] && [ "$line" -gt 0 ] 2>/dev/null; then
    $EDITOR "+$line" "$file"
  else
    $EDITOR "$file"
  fi
)
"@prev" = ReloadPrev
"@print" = Print({-})
"@print_2" = Print({-!})
"@reload" = Reload
"@unwind" = Unwind
"Alt-/" = PreviewJump
