## presets/ai/pi_extensions.toml
[binds]
"@Accept" = Accept
"@accept" = @toggle extension, Reload
"@accept_2" = Accept
"@break" = Redraw
"@copy" = CopyAsync(printf '%s
' {+1})
"@copy_active" = CopyAsync(printf '%s
' {+!})
"@copy_all" = CopyAsync(printf {})
"@cycle" = ReloadNext
"@help" = Help
"@install" = ExecuteOrConfirm(
import json, os, shutil, subprocess, sys, tempfile

mmx = os.environ.get("MM_EXTENSIONS_FILE") or os.path.expanduser("~/.pi/agent/mm_extensions")

sys.stderr.write("source to install (e.g. https://github.com/user/repo): ")
sys.stderr.flush()
url = sys.stdin.readline().strip()
if not url:
    sys.stderr.write("error: no source entered\n")
    sys.exit(1)

pi = shutil.which("pi")
if pi is None:
    sys.stderr.write("error: pi executable not found on PATH\n")
    sys.exit(1)

r = subprocess.run([pi, "install", url])
if r.returncode != 0:
    sys.stderr.write("error: pi install failed for " + url + "\n")
    sys.exit(1)

line = json.dumps(url, ensure_ascii=False) + ","
if os.path.isfile(mmx):
    with open(mmx, encoding="utf-8") as f:
        lines = f.read().splitlines()
    for ln in lines:
        stripped = ln[2:] if ln.startswith("# ") else (ln[1:] if ln.startswith("#") else ln)
        try:
            value = json.loads(stripped.rstrip(","))
        except json.JSONDecodeError:
            continue
        name = value.get("source") if isinstance(value, dict) else value
        if name == url:
            print("already listed in mm_extensions: " + url)
            sys.exit(0)
    lines.append(line)
else:
    os.makedirs(os.path.dirname(os.path.abspath(mmx)), exist_ok=True)
    lines = [line]

fd, tmp = tempfile.mkstemp(prefix="mm_add.", suffix=".tmp", dir=os.path.dirname(os.path.abspath(mmx)))
with os.fdopen(fd, "w", encoding="utf-8") as f:
    f.write("\n".join(lines) + "\n")
os.replace(tmp, mmx)
print("installed and added to mm_extensions: " + url)
)
"@look" = Execute(eval $MM_PREVIEW_COMMAND | $PAGER)
"@next" = ReloadNext
"@open" = Execute(
import os, subprocess, shlex
from pathlib import Path

editor = os.environ.get("EDITOR", "nano")
target = Path("~/.pi/agent/settings.json").expanduser()
subprocess.run([*shlex.split(editor), str(target)])
)
"@open_2" = Execute(
import os, subprocess, shlex
from pathlib import Path

editor = os.environ.get("EDITOR", "nano")
target = Path(".pi/agent/settings.json").resolve()
subprocess.run([*shlex.split(editor), str(target)])
)
"@prev" = ReloadPrev
"@print" = Print({-})
"@print_2" = Print({-!})
"@prune" = ExecuteOrConfirm(@pi_extensions_prune.py)
"@reconcile" = ExecuteOrConfirm(@pi_extensions_reconcile.py)
"@reload" = @reconcile, Reload
"@rm" = @uninstall, Reload
"@set global" = ExecuteOrConfirm(@pi_extensions_set.py global), RunPreview(cat ~/.pi/agent/settings.json)
"@set local" = ExecuteOrConfirm(@pi_extensions_set.py local), RunPreview(cat .pi/settings.json)
"@show" = RunPreview(
    for f in .pi/settings.json "$HOME/.pi/agent/settings.json"; do
        [[ -e "$f" ]] &&
        echo "===== $f =====" &&
        cat -- "$f" 2>/dev/null
        echo
    done
)
"@toggle extension" = ExecuteOrConfirm(
import json, os, shlex, subprocess, sys, tempfile

mmx = os.environ.get("MM_EXTENSIONS_FILE") or os.path.expanduser("~/.pi/agent/mm_extensions")

if not os.path.isfile(mmx):
    sys.stderr.write("error: mm_extensions not found: " + mmx + "\n")
    sys.exit(1)

# every selected extension must share the same state (cursor row when nothing is selected)
names = shlex.split(r"""{+1}""")
states = shlex.split(r"""{+2}""")
if not names:
    sys.stderr.write("error: no extension selected\n")
    sys.exit(1)
if len(set(states)) > 1:
    sys.stderr.write("error: selection mixes enabled and disabled extensions\n")
    sys.exit(1)
mode = "off" if states[0] == "✓" else "on"

with open(mmx, encoding="utf-8") as f:
    lines = f.read().splitlines()

out = []
for line in lines:
    if line.startswith("# "):
        stripped = line[2:]
    elif line.startswith("#"):
        stripped = line[1:]
    else:
        stripped = line

    if not stripped.strip():
        out.append(line)
        continue

    try:
        value = json.loads(stripped.rstrip(","))
    except json.JSONDecodeError:
        out.append(line)
        continue
    name = value.get("source") if isinstance(value, dict) else value

    if name in names:
        if mode == "off":
            out.append(line if line.startswith("#") else "# " + line)
        else:
            out.append(stripped if line.startswith("#") else line)
    else:
        out.append(line)

fd, tmp = tempfile.mkstemp(prefix="mm_toggle.", suffix=".tmp", dir=os.path.dirname(os.path.abspath(mmx)))
with os.fdopen(fd, "w", encoding="utf-8") as f:
    f.write("\n".join(out) + ("\n" if out else ""))
os.replace(tmp, mmx)
print("toggled " + str(len(names)) + " extension(s) " + mode + " (apply with alt-enter / ctrl-enter)")
)
"@uninstall" = ExecuteOrConfirm(
import json, os, shlex, shutil, subprocess, sys, tempfile

mmx = os.environ.get("MM_EXTENSIONS_FILE") or os.path.expanduser("~/.pi/agent/mm_extensions")

if not os.path.isfile(mmx):
    sys.stderr.write("error: mm_extensions not found: " + mmx + "\n")
    sys.exit(1)

pi = shutil.which("pi")
if pi is None:
    sys.stderr.write("error: pi executable not found on PATH\n")
    sys.exit(1)

names = shlex.split(r"""{+1}""")
if not names:
    sys.stderr.write("error: no extension selected\n")
    sys.exit(1)

with open(mmx, encoding="utf-8") as f:
    lines = f.read().splitlines()

out = []
removed = []
for line in lines:
    if line.startswith("# "):
        stripped = line[2:]
    elif line.startswith("#"):
        stripped = line[1:]
    else:
        stripped = line

    if not stripped.strip():
        out.append(line)
        continue

    try:
        value = json.loads(stripped.rstrip(","))
    except json.JSONDecodeError:
        out.append(line)
        continue
    name = value.get("source") if isinstance(value, dict) else value

    if name in names:
        removed.append(name)
    else:
        out.append(line)

fd, tmp = tempfile.mkstemp(prefix="mm_rm.", suffix=".tmp", dir=os.path.dirname(os.path.abspath(mmx)))
with os.fdopen(fd, "w", encoding="utf-8") as f:
    f.write("\n".join(out) + ("\n" if out else ""))
os.replace(tmp, mmx)

for name in removed:
    r = subprocess.run([pi, "uninstall", name])
    if r.returncode != 0:
        sys.stderr.write("error: pi uninstall failed for " + name + "\n")
        sys.exit(1)

print("removed " + str(len(removed)) + " extension(s) from mm_extensions and pi settings")
)
"@unwind" = Unwind
