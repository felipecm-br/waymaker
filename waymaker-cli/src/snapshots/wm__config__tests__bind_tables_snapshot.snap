"+" = DiagramZoomIn
"," = SortMenu
"-" = DiagramZoomOut
"." = NextColumn
"/" = FocusFilter
"0" = DiagramResetZoom
"=" = DiagramZoomIn
">" = PrevColumn
"G" = PreviewDown(0)
"J" = PreviewDown(5)
"K" = PreviewUp(5)
"N" = PrevDiagram
"U" = Reload(curr="$(pwd)"; while [ "$curr" != "/" ] && [ -n "$curr" ]; do curr="$(dirname "$curr")"; echo "$curr"; done), Cancel, Pos(0)
"[" = PrevDiagram
"\\" = ToggleParentPeek
"]" = NextDiagram
"b" = @bookmarks
"backtab" = @reloadprev
"ctrl-J" = PreviewDown(5)
"ctrl-K" = PreviewUp(5)
