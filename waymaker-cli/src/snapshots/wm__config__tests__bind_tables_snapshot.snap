expression: out
---
## config.toml
[binds]
"@Accept" = Accept
"@accept" = Accept
"@accept_2" = Accept
"@break" = Redraw
"@copy" = CopyAsync(printf '%s
' {+1})
"@copy_active" = CopyAsync(printf '%s
' {+!})
"@copy_all" = CopyAsync(printf {})
"@cycle" = ReloadNext
"@help" = Help
"@look" = Execute(eval $MM_PREVIEW_COMMAND | $PAGER)
"@next" = ReloadNext
"@open" = Execute($EDITOR {1})
"@open_2" = Become($EDITOR {1})
"@prev" = ReloadPrev
"@print" = Print({-})
"@print_2" = Print({-!})
"@reload" = Reload
"@unwind" = Unwind
"Alt-/" = PreviewJump
"Alt-0" = Pos(-1)
"Alt-1" = Pos(0)
"Alt-=" = ExpandPreview(2)
"Alt-Down" = VScroll(-1)
"Alt-Enter" = @Accept
