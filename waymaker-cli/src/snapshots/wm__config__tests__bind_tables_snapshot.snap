"|" = ToggleParentPeek

## presets/win.rg.toml
[binds]
"0,1^^@accept" = Become(powershell -Command "& $env:EDITOR {1}")
"@Accept" = Accept
"@accept" = Accept
"@accept_2" = Accept
"@break" = Redraw
"@copy" = CopyAsync(printf '%s
' {+1})
"@copy_active" = CopyAsync(printf '%s
' {+!})
"@copy_all" = CopyAsync(printf {})
"@cycle" = ReloadNext
"@enter_mm" = Filtering(true), Unbind(QueryChange), Transform(
    if ($env:MM_QUERY) {
        Write-Output "SetPrompt(($env:MM_QUERY) )"
    } else {
        Write-Output "SetStyledPrompt({blue,italic:wm> })"
    }

    Write-Output "SetQuery($env:MM_STORE)"
    Write-Output "Store($env:MM_QUERY)"
    Write-Output "SwitchColumn(1)"
), Bind(@reload = @enter_rg)
"@enter_rg" = Filtering(false), Bind(QueryChange = Reload), Transform(
    if ($env:MM_QUERY) {
        $trimmedQuery = $env:MM_QUERY -replace '^%1\s*', ''
        Write-Output "SetStyledPrompt({blue,italic:($trimmedQuery)} )"
    } else {
        Write-Output "SetPrompt(rg> )"
    }

    Write-Output "SetQuery($env:MM_STORE)"
    Write-Output "Store($env:MM_QUERY)"
), Bind(@reload = @enter_mm)
"@help" = Help
"@look" = Execute(eval $MM_PREVIEW_COMMAND | $PAGER)
"@next" = ReloadNext
"@open" = Execute($EDITOR {1})
"@open_2" = Become($EDITOR {1})
"@prev" = ReloadPrev
"@print" = Print({-})
"@print_2" = Print({-!})
"@reload" = Reload
"@unwind" = Unwind
"Alt-/" = PreviewJump
"Alt-0" = Pos(-1)
"Alt-1" = Pos(0)
"Alt-=" = ExpandPreview(2)
"Alt-Down" = VScroll(-1)
"Alt-Enter" = @Accept
"Alt-Hyphen" = ShrinkPreview(2)
"Alt-Left" = HScroll(-1)
"Alt-Right" = HScroll(1)
"Alt-Shift-=" = ExpandPreview(10)
"Alt-Shift-p" = @print_2
"Alt-Up" = VScroll(1)
"Alt-a" = QueryPos(0)
"Alt-h" = Help
"Alt-o" = @open_2
"Alt-p" = @print
"Alt-y" = @copy_active
"Backspace" = DeleteChar
"Ctrl-." = NextColumn
"Ctrl-/" = CyclePreview
"Ctrl-Enter" = @accept_2
"Ctrl-Left" = BackwardWord
"Ctrl-Right" = ForwardWord
"Ctrl-Shift-." = PrevColumn
"Ctrl-Shift-/" = CyclePreview
"Ctrl-Shift-BackTab" = @prev
"Ctrl-Shift-Down" = VScroll(-1)
"Ctrl-Shift-Left" = HScroll(-1)
"Ctrl-Shift-Right" = HScroll(1)
"Ctrl-Shift-Tab" = @prev
"Ctrl-Shift-Up" = VScroll(1)
"Ctrl-Shift-n" = @next
"Ctrl-Shift-p" = @prev
"Ctrl-Shift-r" = @reload_2
"Ctrl-Shift-y" = @copy_all
"Ctrl-Tab" = @next
"Ctrl-]" = ExpandPreview(2)
"Ctrl-a" = CycleAll
"Ctrl-c" = Quit
"Ctrl-d" = @rm
"Ctrl-g" = Pos(-1)
"Ctrl-h" = DeleteWord
"Ctrl-j" = Down
"Ctrl-k" = Up
"Ctrl-l" = @look
"Ctrl-o" = @open
"Ctrl-p" = SwitchPreview
"Ctrl-r" = @reload
"Ctrl-s" = @show
"Ctrl-u" = Cancel
"Ctrl-y" = @copy
"Delete" = @rm
"Down" = Down
"Enter" = @accept
"Esc" = @unwind
"F1" = @help
"F10" = @menu
"F11" = @look
"F12" = @save
"F2" = @rename
"F3" = @search
"F4" = @rm
"F5" = @reload
"F6" = @cycle
"F7" = @build
"F8" = @step
"F9" = @break
"Left" = BackwardChar
"PageDown" = HalfPageDown
"PageUp" = HalfPageUp
"Right" = ForwardChar
"Shift-BackTab" = ToggleUp
"Shift-Down" = PreviewHalfPageDown
"Shift-Up" = PreviewHalfPageUp
"Start" = @enter_rg
"Tab" = Toggle
"Up" = Up
"shift+scrolldown" = PreviewDown
"shift+scrollup" = PreviewUp
[ui.nav.binds]
" " = Toggle
"," = SortMenu
"." = NextColumn
"/" = FocusFilter
">" = PrevColumn
"G" = PreviewDown(0)
"J" = PreviewDown
"K" = PreviewUp
"\\" = ToggleParentPeek
"esc" = Quit
"gb" = Pos(-1)
"gg" = PreviewUp(0)
"gt" = Pos(0)
"j" = Down
"k" = Up
"q" = Quit
"|" = ToggleParentPeek

