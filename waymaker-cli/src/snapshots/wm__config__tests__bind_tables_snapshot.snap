if "$(dirname -- "$MM_OVERRIDE")"/zellij.sh has-current-panes; then
    exec wm -o terminal/zellij_current
else
    exec wm -o terminal/zellij_session
fi
)
"@print" = Print({-})
"@print_2" = Print({-!})
