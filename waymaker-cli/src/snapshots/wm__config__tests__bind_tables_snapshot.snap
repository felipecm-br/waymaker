"@cycle" = ReloadNext
"@help" = Help
"@look" = Execute(eval $MM_PREVIEW_COMMAND | $PAGER)
"@next" = BecomeSilent(
if [ -z "$(git status --porcelain)" ]; then
    wm -o git/restore
else
    wm -o git/status -F
fi)
"@open" = Execute($EDITOR {1})
"@open_2" = Become($EDITOR {1})
"@prev" = BecomeSilent(wm -o git/switch)
