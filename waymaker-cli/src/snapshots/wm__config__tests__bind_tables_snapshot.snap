## presets/git/status.toml
[binds]
"@Accept" = Accept
"@accept" = #stage, @stage, Reload
"@accept_2" = Accept
"@break" = Redraw
"@commit" = BecomeOrConfirm(
set -e
if git diff --cached --quiet; then
  git add .
fi
git --no-pager diff --color=always --cached --compact-summary
echo
echo "Commit message (\ -> continue): "
msg=""
while IFS= read -r line; do
  if [[ "$line" == *'\' ]]; then
    msg+="${line%?}"$'\n'
    printf "> "
  else
    msg+="$line"
    break
  fi
done

if [ -n "$msg" ]; then
  git commit -m "$msg"
else
  git commit
fi
)
"@copy" = CopyAsync(printf '%s
' {+1})
"@copy_active" = CopyAsync(printf '%s
' {+!})
"@copy_all" = CopyAsync(printf {})
"@cycle" = ReloadNext
"@help" = Help
"@ignore" = ExecuteOrConfirm(
set -e
for f in {+1}; do
  git rm -r --cached "$f" 2>/dev/null &&
  echo "$f" >> .gitignore
done
)
"@look" = Execute(eval $MM_PREVIEW_COMMAND | $PAGER)
"@next" = BecomeSilent(wm -o git/restore)
"@open" = Execute($EDITOR {1})
"@open_2" = Become($EDITOR {1})
"@prev" = BecomeSilent(wm -o git/grep)
"@print" = Print({-})
"@print_2" = Print({-!})
"@reload" = Reload
"@rename" = ExecuteOrConfirm(
set -- {+1}
echo "Rename $1 to: "
read -r new_name
[ -n "$new_name" ] || exit
mkdir -p "$(dirname "$new_name")"
git mv "$1" "$new_name"
)
"@restore" = ExecuteOrConfirm(
set -e
set -- {+1}
if (( $# == 1 )); then
  file="$1"
  if git diff --cached --quiet -- "$file" 2>/dev/null; then
    printf "Restore %s to HEAD? [Y/n] " "$file"
  else
    printf "Restore %s to HEAD? [Y/n/s(taging)] " "$file"
  fi
  read -r ans
  case "${ans%% *}" in
    [Yy]*|'') git restore --source=HEAD --staged --worktree -- "$file" ;;
    [sS]*) git restore -- "$file" ;;
  esac
else
  printf "Restore %d files? [Y/n/s(taging)] " "$#"
  read -r ans
  case "${ans%% *}" in
    [Yy]*|'') git restore --source=HEAD --staged --worktree -- "$@" ;;
    [sS]*) git restore -- "$@" ;;
  esac
fi
)
"@rm" = #untrack, @untrack, Reload
"@save_staged" = BecomeOrConfirm(
set -e

# Get the current branch name and short hash
cur=$(git symbolic-ref --short HEAD 2>/dev/null || echo "HEAD")
cur_hash=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")

default_name="$cur-save"
printf "Branch name [%s]: " "$default_name"
read -r name
name="${name:-$default_name}"
msg="Saved changes ($cur_hash)"

if git diff --cached --quiet; then
  git branch "$name" &&
  echo "No staged changes. Created branch '$name'..."
else
  # 1. Package the index into a tree
  tree=$(git write-tree)

  # 2. Create a standalone commit from that tree attached to HEAD
  commit=$(echo "$msg" | git commit-tree "$tree" -p HEAD)

  # 3. Point the new branch at the newly created commit
  git branch "$name" "$commit"

  echo "Staged changes successfully saved to '$name'."
  exit 1
fi
)
"@show" = @commit
"@stage" = ExecuteAsync(
set -e

if [[ "$MM_TOTAL_COUNT" != "$MM_SELECT_COUNT" ]]; then
  set -- {+1}
else
  set -- .
fi

f={1}
ac=true
ad=true

# stage if cursor is not fully staged
if [ -n "$(git ls-files --others --exclude-standard -- "$f")" ]; then
    ac=false
elif git diff --quiet -- "$f"; then
    ad=false
else
    ac=false
fi

if $ac; then git reset -q -- "$@"; else git add -- "$@"; fi
# git update-index --refresh
)
"@stash" = ExecuteOrConfirm(
set -e
printf "Stash message (optional): "
read -r msg
if [ -n "$msg" ]; then
  git stash push -u -m "$msg" -- {+1}
else
  git stash push -- {+1}
fi
)
"@stash_unstaged" = ExecuteOrConfirm(git stash --keep-index --include-untracked)
"@summary" = RunPreview(git -c color.ui=always status -sbu && echo && git --no-pager diff --color=always --compact-summary && false)
"@unstage" = ExecuteAsync(
set -e

if ((MM_SELECT_COUNT)); then
  set -- {+1}
else
  set -- .
fi

ac=true

# only stage if every selected is fully unstaged
for f; do
  git diff --cached --quiet -- "$f" || { ac=false; break; }
done

if $ac; then
  git add -- "$@"
else
  git reset -q -- "$@"
fi
)
"@untrack" = ExecuteOrConfirm(
set -e

git ls-files -z --cached --exclude-standard -- {+1} |
while IFS= read -r -d '' file; do
  files+=("$file")
done

[ ${#files[@]} -eq 0 ] && echo "No tracked files selected" && exit 1

if git rm --cached -n -- "${files[@]}" >/dev/null; then
  git rm --cached -- "${files[@]}"
else
  printf "Force untrack ${#files} files? [y/N] "
  read -r ans
  case "$ans" in
    [yY]*) git rm --cached -f -- "${files[@]}" ;;
  esac
fi
)
"@unwind" = Unwind
"Alt-/" = PreviewJump
"Alt-0" = Pos(-1)
"Alt-1" = Pos(0)
"Alt-=" = ExpandPreview(2)
"Alt-Down" = VScroll(-1)
"Alt-Enter" = @Accept
"Alt-Hyphen" = ShrinkPreview(2)
"Alt-Left" = HScroll(-1)
"Alt-Right" = HScroll(1)
"Alt-Shift-=" = ExpandPreview(10)
"Alt-Shift-p" = @print_2
"Alt-Up" = VScroll(1)
"Alt-a" = QueryPos(0)
"Alt-c" = ExecuteOrConfirm(git add . && echo 'All changes staged' || echo 'git add . failed'), @commit
"Alt-d" = #delete from disk, ExecuteOrConfirm(rm -rf -- {+1}), Reload
"Alt-h" = Help
"Alt-i" = @ignore, Reload
"Alt-o" = @open_2
"Alt-p" = @print
"Alt-r" = @restore, Reload
"Alt-t" = @stash_unstaged, Reload
"Alt-y" = @copy_active
"Backspace" = DeleteChar
"Ctrl-." = NextColumn
"Ctrl-/" = CyclePreview
"Ctrl-1" = @summary
"Ctrl-Enter" = @accept_2
"Ctrl-Left" = BackwardWord
"Ctrl-Right" = ForwardWord
"Ctrl-Shift-." = PrevColumn
"Ctrl-Shift-/" = CyclePreview
"Ctrl-Shift-BackTab" = @prev
"Ctrl-Shift-Down" = VScroll(-1)
"Ctrl-Shift-Left" = HScroll(-1)
"Ctrl-Shift-Right" = HScroll(1)
"Ctrl-Shift-Tab" = @prev
"Ctrl-Shift-Up" = VScroll(1)
"Ctrl-Shift-c" = @commit_ai, Reload
"Ctrl-Shift-d" = #delete, ExecuteOrConfirm(git add -- {+1}; git rm -rf -- {+1}), Reload
"Ctrl-Shift-n" = @next
"Ctrl-Shift-p" = @prev
"Ctrl-Shift-r" = @reload_2
"Ctrl-Shift-y" = @copy_all
"Ctrl-Tab" = @next
"Ctrl-]" = ExpandPreview(2)
"Ctrl-a" = CycleAll
"Ctrl-b" = @save-staged
"Ctrl-c" = Quit
"Ctrl-d" = @rm
"Ctrl-g" = Pos(-1)
"Ctrl-h" = DeleteWord
"Ctrl-i" = #edit gitignore, Execute($EDITOR .gitignore), Reload
"Ctrl-j" = Down
"Ctrl-k" = Up
"Ctrl-l" = @look
"Ctrl-o" = @open
"Ctrl-p" = SwitchPreview
"Ctrl-r" = @reload
"Ctrl-s" = @show
"Ctrl-t" = @stash, Reload
"Ctrl-u" = @unstage, Reload
"Ctrl-y" = @copy
"Delete" = @rm
"Down" = Down
"Enter" = @accept
"Esc" = @unwind
"F1" = @help
"F10" = @menu
"F11" = @look
"F12" = @save
"F2" = @rename
"F3" = @search
"F4" = @rm
"F5" = @reload
"F6" = @cycle
"F7" = @build
"F8" = @step
"F9" = @break
"Left" = BackwardChar
"PageDown" = HalfPageDown
"PageUp" = HalfPageUp
"Right" = ForwardChar
"Shift-BackTab" = ToggleUp
"Shift-Down" = PreviewHalfPageDown
"Shift-Up" = PreviewHalfPageUp
"Tab" = Toggle
"Up" = Up
"shift+scrolldown" = PreviewDown
"shift+scrollup" = PreviewUp
[ui.nav.binds]
" " = Toggle
"," = SortMenu
"." = NextColumn
"/" = FocusFilter
">" = PrevColumn
"G" = PreviewDown(0)
"J" = PreviewDown
"K" = PreviewUp
"\\" = ToggleParentPeek
"esc" = Quit
"gb" = Pos(-1)
"gg" = PreviewUp(0)
"gt" = Pos(0)
"j" = Down
"k" = Up
"q" = Quit
"|" = ToggleParentPeek

## presets/git/switch.toml
[binds]
"@Accept" = @switch_silent, Reload
"@accept" = @switch
"@accept_2" = Accept
"@add_branch" = ExecuteOrConfirm(
set -e
printf "New branch name: "
read -r branch
[ -n "$branch" ] || exit
git switch -c "$branch"
)
"@add_remote" = ExecuteOrConfirm(
set -e

remote="$(eval "$LSREMOTE")"

printf "Remote name [%s]: " "$remote"
read -r name
name="${name:-$remote}"

prompt_set=false

if git remote 2>/dev/null | grep -q "^$name$"; then
    current_url=$(git remote get-url "$name" 2>/dev/null)
    printf "Remote '%s' already exists (%s).\n" "$name" "$current_url"
    printf "Change its URL? [y/N] "
    read -r ans

    case "$ans" in
        [yY]*)
            printf "New URL: "
            read -r url
            git remote set-url "$name" "$url"
            ;;
        *)
            prompt_set=true
            ;;
    esac
else
    printf "Remote URL: "
    read -r url
    git remote add "$name" "$url"
    prompt_set=true
fi

current_branch=$(git symbolic-ref --short HEAD 2>/dev/null || true)
if $prompt_set && [ -n "$current_branch" ]; then
    upstream_remote=$(git config "branch.$current_branch.remote" 2>/dev/null || true)
    if [ "$upstream_remote" != "$name" ]; then
        printf "Set '%s' as the default remote for branch '%s'? [y/N] " "$name" "$current_branch"
        read -r set_def
        case "$set_def" in
            [yY]*)
                # We use git config here instead of branch --set-upstream-to
                # because it works completely offline without needing to fetch first.
                git config "branch.$current_branch.remote" "$name"
                git config "branch.$current_branch.merge" "refs/heads/$current_branch"
                ;;
        esac
    fi
fi
)
"@break" = Redraw
"@copy" = CopyAsync(printf '%s
' {+1})
"@copy_active" = CopyAsync(printf '%s
' {+!})
"@copy_all" = CopyAsync(printf {})
"@copy_remote" = CopyAsync(
remote="$(eval "$LSREMOTE")"
git remote get-url "$remote"
)
"@cycle" = ReloadNext
"@delete" = ExecuteOrConfirm(
set -e

case "$MM_INDEX" in
0)
    set -- {+2};
    while (($#)); do
        branch="$1"
        shift 1
        if [[ "$branch" == *":"* ]]; then
             remote="${branch%%:*}"
             branch="${branch#*:}"
             if [ -n "$remote" ] && [ -n "$branch" ]; then
                 printf "Delete remote branch '%s' from '%s'? [y/N]: " "$branch" "$remote"
                 read -r confirm
                 case "$confirm" in
                     [Yy]*)
                         echo "Deleting remote branch..."
                         git push "$remote" --delete "$branch"
                         ;;
                     *)
                         echo "Operation canceled."
                         exit 0
                         ;;
                 esac
             else
                 echo "Error: Invalid ref format. Expected 'remote:branch'."
                 exit 1
             fi
        else
            printf "Delete local branch %s? [y/N] " "$branch"
            read -r ans

            case "$ans" in
                [yY]*)
                    # 1. Resolve upstream BEFORE deleting the local branch
                    upstream="$(git rev-parse --abbrev-ref "${branch}@{u}" 2>/dev/null || true)"

                    # 2. Delete the local branch
                    git branch -D "$branch"

                    # 3. Handle remote deletion if an upstream was tracked
                    if [ -n "$upstream" ]; then
                        remote="${upstream%%/*}"
                        remote_branch="${upstream#*/}"

                        printf "Also delete remote branch %s/%s? [y/N] " "$remote" "$remote_branch"
                        read -r rans

                        case "$rans" in
                            [yY]*)
                                git push "$remote" --delete "$remote_branch"
                                ;;
                        esac
                    fi
                    ;;
                *)
                    exit 0
                    ;;
            esac
        fi
    done
    ;;
1)
    set -- {+2};
    auto_remote=0
    remote="$(eval "$LSREMOTE")"

    while (($#)); do
        printf "Delete tag $1? [y/N/aA] "
        read -r ans

        case "$ans" in
            [aA]*)
                git tag -d "$@"

                printf "Delete remote tags too? [y/N] "
                read -r rans

                case "$rans" in
                    [yY]*)
                        for t in "$@"; do
                            set -- "$@" "refs/tags/$t"
                            shift
                        done

                        git push "$remote" --delete "$@"
                        ;;
                    *)
                        exit 0
                        ;;
                esac
                ;;
            [yY]*)
                git tag -d "$1"

                if [ "$auto_remote" -eq 1 ]; then
                    git push "$remote" --delete "refs/tags/$1"
                else
                    printf "Delete remote tag too? [y/N/(all)] "
                    read -r rans

                    case "$rans" in
                        [aA]*)
                            auto_remote=1
                            git push "$remote" --delete "refs/tags/$1"
                            ;;
                        [yY]*)
                            git push "$remote" --delete "refs/tags/$1"
                            ;;
                    esac
                fi

                shift
                ;;
            *)
                shift
                ;;
        esac
    done
    ;;
2)
    remote="$(eval $LSREMOTE)"
    set -- {+2}

    for arg in "$@"; do
        set -- "$@" "refs/$arg"
        shift
    done

    printf "Delete %d refs from %s? [Y/n]: " "$#" "$remote"
    read -r response

    case "$response" in
        [Yy]*|"")
            git push "$remote" --delete "$@"
            ;;
        *)
            echo "Deletion cancelled."
            exit 1
            ;;
    esac
    ;;
3)
    set -- {+2}

    type=""
    remote=""
    mixed_remotes=false

    # Guard against mixed types
    for item; do
        case "$item" in
            heads/*)
                current_type="head"
                set -- "$@" "${item#heads/}"
                ;;
            tags/*)
                current_type="tag"
                set -- "$@" "${item#tags/}"
                ;;
            remotes/*)
                current_type="remote"
                clean_ref="${item#remotes/}"
                current_remote="${clean_ref%%/*}"
                branch="${clean_ref#*/}"

                if [ -z "$remote" ]; then
                    remote="$current_remote"
                elif [ "$remote" != "$current_remote" ]; then
                    mixed_remotes=true
                fi

                set -- "$@" "$clean_ref"
                ;;
            *)
                echo "Unknown or unsupported reference type: $item"
                exit 1
                ;;
        esac

        if [ -n "$type" ] && [ "$type" != "$current_type" ]; then
            echo "Error: Mixed types are not supported." >&2
            exit 1
        fi
        type="$current_type"
        shift
    done

    case "$type" in
        head)
            printf "Delete %d local branches? [y/N] " "$#"
            read -r ans
            case "$ans" in
                [yY]*) git branch -D "$@" ;;
            esac
            ;;

        tag)
            printf "Delete %d tags? [y/N] " "$#"
            read -r ans
            case "$ans" in
                [yY]*) git tag -d "$@" ;;
            esac
            ;;

        remote)
            if $mixed_remotes; then
                printf "Mixed remotes detected. Delete %d local tracking caches? [y/N]: " "$#"
                read -r ans
                case "$ans" in
                    [yY]*)
                        echo "Deleting local tracking caches..."
                        git branch -d -r "$@"
                        ;;
                    *)
                        echo "Skipped."
                        ;;
                esac
            else
                printf "Delete %d remote branches from '%s'? [Y=push delete / c=cache only / n=cancel]: " "$#" "$remote"
                read -r ans

                case "$ans" in
                    [Yy]*|"")
                        echo "Pushing deletions to remote..."
                        # Extract just the branch names for the push command
                        for item; do
                            set -- "$@" "${1#*/}"
                            shift
                        done
                        git push "$remote" --delete "$@"
                        ;;
                    [Cc]*)
                        echo "Deleting local tracking caches..."
                        git branch -d -r "$@"
                        ;;
                    *)
                        echo "Skipped."
                        ;;
                esac
            fi
            ;;
    esac
    ;;

*)
    echo "Unavailable"
    exit 1
    ;;
esac
)
"@help" = Help
"@look" = Execute(eval $MM_PREVIEW_COMMAND | $PAGER)
"@next" = BecomeSilent(wm -o git/grep)
"@open" = Execute($EDITOR {1})
"@open_2" = Become($EDITOR {1})
"@prev" = BecomeSilent(wm -o git/restore)
"@print" = Print({-})
"@print_2" = Print({-!})
"@reload" = Reload
"@rename" = ExecuteOrConfirm(
set -e

remote="$(eval "$LSREMOTE")"

case "$MM_INDEX" in
0)
    branch={2}
    if [[ "$branch" == *":"* ]]; then
        old_remote="${branch%%:*}"
        printf "Rename REMOTE %s to: " "$old_remote"
        read -r new_name
        if [ -n "$new_name" ]; then
            # Rename
            git remote rename "$old_remote" "$new_name"
        else
            # Input was empty -> Prompt to delete
            printf "Do you want to DELETE remote '%s'? [y/N]: " "$old_remote"
            read -r confirm

            case "$confirm" in
                [Yy]*)
                    git remote remove "$old_remote"
                    ;;
                *)
                    echo "Operation canceled."
                    exit 0
                    ;;
            esac
        fi
    else
        printf "Rename branch %s to: " "$branch"
        read -r new_name
        [ -n "$new_name" ] || exit
        git branch -m "$branch" "$new_name"

        printf "push? [y/N] "
        read -r ans
        case "$ans" in
        [yY]*)
            git push "$remote" "$new_name" &&
            git push "$remote" --delete "$branch"
            ;;
        esac
    fi
    ;;
1)
    printf "Rename tag %s to: " {2}
    read -r new_tag
    [ -n "$new_tag" ] || exit

    git tag "$new_tag" {2}
    git tag -d {2}

    printf "push? [y/N] "
    read -r ans
    case "$ans" in
        [yY]*)
            git push "$remote" "$new_tag" &&
            git push "$remote" --delete "{2}"
            ;;
        [nN]*|'')
            git push "$remote" "$new_tag"
            ;;
    esac
    ;;
3)
    ref=refs/{2}
    case "$ref" in
        refs/heads/*)
            branch="${ref#refs/heads/}"
            printf "Rename local branch %s to: " "$branch"
            read -r new_name
            [ -n "$new_name" ] || exit
            git branch -m "$branch" "$new_name"
            ;;
        refs/tags/*)
            tag="${ref#refs/tags/}"
            printf "Rename tag %s to: " "$tag"
            read -r new_tag
            [ -n "$new_tag" ] || exit
            git tag "$new_tag" "$tag"
            git tag -d "$tag"
            ;;
        *)
            echo "Cannot rename remote tracking references."
            false
            ;;
    esac
    ;;
*)
    echo "Unavailable"
    false
    ;;
esac
)
"@rm" = @delete, Reload
"@show_remotes" = ExecuteOrConfirm(
git remote | while IFS= read -r remote; do
    echo "=== $remote ==="
    git remote show "$remote"
    echo
done
false
)
"@switch" = Become(
set -e
if [ -n "$(git -c color.ui=always status --porcelain -s | tee /dev/tty)" ]; then
    printf "Local changes detected, continue? [y/N/stash] "
    read -r ans
    case "$ans" in
        [sS]*) git stash ;;
        [yY]*) ;;
        *) exit 0 ;;
    esac
fi

case "$MM_INDEX" in
0)
  branch={2}
  git switch -q "${branch#*:}" &&
  git --no-pager branch -vv --list "$(git branch --show-current)" --color=always
  ;;
1)
  git switch --detach {2}
  ;;
2)
  ref=refs/{2}
  remote="$(eval "$LSREMOTE")"

  case "$ref" in
    refs/heads/*)
      name="${ref#refs/heads/}"
      git fetch "$remote" "$ref:$name"
      if git rev-parse --verify --quiet "$name"; then
          git switch "$name" && git branch --set-upstream-to="$remote/$name"
      else
          git switch -c "$name" --track "$remote/$name"
      fi
      ;;
    *)
      git fetch "$remote" "$ref"
      git switch --detach FETCH_HEAD
      ;;
  esac
  ;;
3)
  ref=refs/{2}
  case "$ref" in
    refs/heads/*)
      git switch "${ref#refs/heads/}"
      ;;
    *)
      git switch --detach "$ref"
      ;;
  esac
  ;;
esac
)
"@switch_silent" = ExecuteOrConfirm(
set -e
case "$MM_INDEX" in
0)
    branch={2}
    git switch "${branch#*:}"
    ;;
1)
    git switch --detach {2}
    ;;
2)
    ref=refs/{2}
    remote="$(eval "$LSREMOTE")"
    case "$ref" in
    refs/heads/*)
        name="${ref#refs/heads/}"
        git fetch "$remote" "$ref:$name"
        git switch -c "$name" --track "$remote/$name"
        ;;
    *)
        git fetch "$remote" "$ref"
        git switch --detach FETCH_HEAD
        ;;
    esac
    ;;
3)
    ref=refs/{2}
    case "$ref" in
      refs/heads/*)
        git switch "${ref#refs/heads/}"
        ;;
      *)
        git switch --detach "$ref"
        ;;
    esac
    ;;
esac
)
"@unwind" = Unwind
"@update" = ExecuteOrConfirm(
set -e
case "$MM_INDEX" in
0)
    branch={2}
    if [[ "branch" == *":"* ]]; then
        remote="${branch%%:*}"
        echo "Fetching $remote..."
        git fetch "$remote"
    else
        current="$(git branch --show-current)"
        git switch "$branch"
        echo "Updating branch $branch..."
        git pull --rebase --autostash
        git status -sb
        git switch "$current"
    fi
    ;;
1)
    echo "Fetching tags..."
    git fetch --tags
    ;;
2)
    remote="$(eval $LSREMOTE)"
    echo "Fetching $remote..."
    git fetch $remote
    ;;
3)
    echo "Fetching all remotes (with prune)..."
    git fetch --all --prune
    ;;
esac
false
)
"Alt-/" = PreviewJump
"Alt-0" = Pos(-1)
"Alt-1" = Pos(0)
"Alt-=" = ExpandPreview(2)
"Alt-Down" = VScroll(-1)
"Alt-Enter" = @Accept
"Alt-Hyphen" = ShrinkPreview(2)
"Alt-Left" = HScroll(-1)
"Alt-Right" = HScroll(1)
"Alt-Shift-=" = ExpandPreview(10)
"Alt-Shift-p" = @print_2
"Alt-Up" = VScroll(1)
"Alt-a" = @copy_remote
"Alt-h" = Help
"Alt-o" = @open_2
"Alt-p" = @print
"Alt-r" = @show_remotes
"Alt-u" = Execute(git config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*" && git fetch origin), Reload
"Alt-y" = @copy_active
"Backspace" = DeleteChar
"Ctrl-." = NextColumn
"Ctrl-/" = CyclePreview
"Ctrl-Enter" = @accept_2
"Ctrl-Left" = BackwardWord
"Ctrl-Right" = ForwardWord
"Ctrl-Shift-." = PrevColumn
"Ctrl-Shift-/" = CyclePreview
"Ctrl-Shift-BackTab" = @prev
"Ctrl-Shift-Down" = VScroll(-1)
"Ctrl-Shift-Left" = HScroll(-1)
"Ctrl-Shift-Right" = HScroll(1)
"Ctrl-Shift-Tab" = @prev
"Ctrl-Shift-Up" = VScroll(1)
"Ctrl-Shift-n" = @next
"Ctrl-Shift-p" = @prev
"Ctrl-Shift-r" = @reload_2
"Ctrl-Shift-y" = @copy_all
"Ctrl-Tab" = @next
"Ctrl-]" = ExpandPreview(2)
"Ctrl-a" = @add_remote, Reload
"Ctrl-c" = Quit
"Ctrl-d" = @rm
"Ctrl-g" = Pos(-1)
"Ctrl-h" = DeleteWord
"Ctrl-j" = Down
"Ctrl-k" = Up
"Ctrl-l" = @look
"Ctrl-n" = @add_branch, Reload
"Ctrl-o" = @open
"Ctrl-p" = SwitchPreview
"Ctrl-r" = @reload
"Ctrl-s" = @show
"Ctrl-u" = @update, Reload
"Ctrl-y" = @copy
"Delete" = @rm
"Down" = Down
"Enter" = @accept
"Esc" = @unwind
"F1" = @help
"F10" = @menu
"F11" = @look
"F12" = @save
"F2" = @rename
"F3" = @search
"F4" = @rm
"F5" = @reload
"F6" = @cycle
"F7" = @build
"F8" = @step
"F9" = @break
"Left" = BackwardChar
"PageDown" = HalfPageDown
"PageUp" = HalfPageUp
"Reloaded" = Transform(
    HEADERS=(
      branches
      tags
      ls-remote
      refs
    )

    case "$MM_INDEX" in
        0) ref=" ($(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD))" ;;
        2) ref=" ($(eval $LSREMOTE))" ;;
        3) ref=" (cached)" ;;
    esac

    setopt KSH_ARRAYS 2>/dev/null
    echo "SetHeader(${HEADERS[$MM_INDEX]}$ref)"
)
"Right" = ForwardChar
"Shift-BackTab" = ToggleUp
"Shift-Down" = PreviewHalfPageDown
"Shift-Up" = PreviewHalfPageUp
"Start" = Transform(
    HEADERS=(
      branches
      tags
      ls-remote
      refs
    )

    case "$MM_INDEX" in
        0) ref=" ($(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD))" ;;
        2) ref=" ($(eval $LSREMOTE))" ;;
        3) ref=" (cached)" ;;
    esac

    setopt KSH_ARRAYS 2>/dev/null
    echo "SetHeader(${HEADERS[$MM_INDEX]}$ref)"
)
"Tab" = Toggle
"Up" = Up
"shift+scrolldown" = PreviewDown
"shift+scrollup" = PreviewUp
[ui.nav.binds]
" " = Toggle
"," = SortMenu
"." = NextColumn
"/" = FocusFilter
">" = PrevColumn
"G" = PreviewDown(0)
"J" = PreviewDown
"K" = PreviewUp
"\\" = ToggleParentPeek
"esc" = Quit
"gb" = Pos(-1)
"gg" = PreviewUp(0)
"gt" = Pos(0)
"j" = Down
"k" = Up
"q" = Quit
"|" = ToggleParentPeek

