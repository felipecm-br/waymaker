## presets/terminal/zellij_session.toml
[binds]
"@Accept" = Accept
"@accept" = Become(
if [ -n "$ZELLIJ" ] || [ -n "$ZELLIJ_SESSION_NAME" ]; then
    case {title} in
        EXITED)
            exec zellij attach {session}
            ;;
        *)
            exec zellij action switch-session {session}
            ;;
    esac
else
    exec zellij attach {session}
fi
)
"@accept_2" = Accept
"@break" = Redraw
"@copy" = CopyAsync(printf '%s\n' {session})
"@copy_active" = CopyAsync(printf '%s
' {+!})
"@copy_all" = CopyAsync(printf {})
"@cycle" = ReloadNext
"@help" = Help
"@look" = Execute(eval $MM_PREVIEW_COMMAND | $PAGER)
"@next" = BecomeSilent(
if "$(dirname -- "$MM_OVERRIDE")"/zellij.sh has-current-panes; then
    exec wm -o terminal/zellij_current
else
    exec wm -o terminal/zellij_layout
fi
)
"@open" = Execute($EDITOR {1})
"@open_2" = Become($EDITOR {1})
"@prev" = BecomeSilent(
if "$(dirname -- "$MM_OVERRIDE")"/zellij.sh has-other-panes; then
    exec wm -o terminal/zellij_other
else
    exec wm -o terminal/zellij_layout
fi
)
"@print" = #print, Become(printf '%s\n' {session})
"@print_2" = Print({-!})
"@reload" = Reload
"@rm" = #kill, ExecuteOrConfirm(
printf "Kill session %s? [Y/n] " {session}
read -r ans
case "$ans" in
    [Yy]*|'') zellij kill-session {session};;
    *) exit 0 ;;
esac
), Reload
"@unwind" = Unwind
"Alt-/" = PreviewJump
"Alt-0" = Pos(-1)
"Alt-1" = Pos(0)
"Alt-=" = ExpandPreview(2)
"Alt-Down" = VScroll(-1)
"Alt-Enter" = @Accept
"Alt-Hyphen" = ShrinkPreview(2)
"Alt-Left" = HScroll(-1)
"Alt-Right" = HScroll(1)
"Alt-Shift-=" = ExpandPreview(10)
