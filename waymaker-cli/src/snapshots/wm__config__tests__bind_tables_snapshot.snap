"Alt-Shift-p" = @print_2
"Alt-Up" = VScroll(1)
"Alt-a" = QueryPos(0)
"Alt-h" = ChDir(..), Cancel, Reload, FocusNav
"Alt-j" = Down
"Alt-k" = Up
"Alt-l" = ChDir({=}), Cancel, Reload, Pos(0), FocusNav
"Alt-o" = @open_2
"Alt-p" = @print
