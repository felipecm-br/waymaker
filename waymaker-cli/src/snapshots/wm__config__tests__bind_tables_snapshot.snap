"Ctrl-j" = Down
"Ctrl-k" = Up
"Ctrl-l" = ChDir({=}), Cancel, Reload, Pos(0), FocusNav
"Ctrl-o" = @open
"Ctrl-p" = SwitchPreview
"Ctrl-r" = @reload
"Ctrl-s" = @show
"Ctrl-u" = Cancel
"Ctrl-v" = @paste_into
