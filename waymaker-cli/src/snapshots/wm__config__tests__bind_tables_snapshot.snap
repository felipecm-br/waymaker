## presets/dict/emoji.toml
[binds]
"@Accept" = Accept
"@accept" = Accept
"@accept_2" = Accept
"@break" = Redraw
"@copy" = CopyAsync(
if ((MM_INDEX == 0)); then
  echo {char}
else
  emoji_seq=$(echo {char} | awk -F'-' '
      function hex2dec(h) {
          v = 0; h = toupper(h)
          for(k=1; k<=length(h); k++) {
              v = v * 16 + index("0123456789ABCDEF", substr(h, k, 1)) - 1
          }
          return v
      }

      function to_utf8_octal(c) {
          if (c <= 127) return sprintf("\\0%03o", c)
          if (c <= 2047) return sprintf("\\0%03o\\0%03o", 192 + int(c/64), 128 + (c%64))
          if (c <= 65535) return sprintf("\\0%03o\\0%03o\\0%03o", 224 + int(c/4096), 128 + int((c/64)%64), 128 + (c%64))
          return sprintf("\\0%03o\\0%03o\\0%03o\\0%03o", 240 + int(c/262144), 128 + int((c/4096)%64), 128 + int((c/64)%64), 128 + (c%64))
      }

      {
          for(i=1; i<=NF; i++) {
              dec = hex2dec($i)
              printf "%s", to_utf8_octal(dec)
          }
      }
  ')
  printf "%b" "$emoji_seq"
fi
)
"@copy_active" = CopyAsync(printf '%s
' {+!})
"@copy_all" = CopyAsync(
if ((MM_INDEX == 0)); then
    char={char}
    printf "\\\\u{%X}" "'$char"
else
    echo {char} | awk -F'-' '{for(i=1;i<=NF;i++) printf "\\u{%s}", toupper($i)}'
fi
)
"@cycle" = ReloadNext
"@help" = Help
"@look" = Execute(eval $MM_PREVIEW_COMMAND | $PAGER)
"@next" = ReloadNext
"@open" = Execute($EDITOR {1})
"@open_2" = Become($EDITOR {1})
"@prev" = ReloadPrev
"@print" = Print({-})
"@print_2" = Print({-!})
"@reload" = ReloadNext
"@reload_2" = ReloadPrev
"@unwind" = Unwind
"Alt-/" = PreviewJump
"Alt-0" = Pos(-1)
"Alt-1" = Pos(0)
"Alt-=" = ExpandPreview(2)
"Alt-Down" = VScroll(-1)
"Alt-Enter" = @Accept
"Alt-Hyphen" = ShrinkPreview(2)
"Alt-Left" = HScroll(-1)
"Alt-Right" = HScroll(1)
"Alt-Shift-=" = ExpandPreview(10)
"Alt-Shift-p" = @print_2
"Alt-Up" = VScroll(1)
"Alt-a" = QueryPos(0)
"Alt-h" = Help
"Alt-o" = @open_2
"Alt-p" = @print
"Alt-y" = @copy_active
"Backspace" = DeleteChar
"Ctrl-." = NextColumn
"Ctrl-/" = CyclePreview
"Ctrl-Enter" = @accept_2
"Ctrl-Left" = BackwardWord
"Ctrl-Right" = ForwardWord
"Ctrl-Shift-." = PrevColumn
"Ctrl-Shift-/" = CyclePreview
"Ctrl-Shift-BackTab" = @prev
"Ctrl-Shift-Down" = VScroll(-1)
"Ctrl-Shift-Left" = HScroll(-1)
"Ctrl-Shift-Right" = HScroll(1)
"Ctrl-Shift-Tab" = @prev
"Ctrl-Shift-Up" = VScroll(1)
